function getBaseOnline() {
	const hour = new Date().getHours();
	// More users in evening (18-23), less at night (2-7)
	if(hour>=18&&hour<=23) return 80+Math.floor(Math.random()*40);
	if(hour>=12&&hour<18) return 50+Math.floor(Math.random()*30);
	if(hour>=8&&hour<12) return 30+Math.floor(Math.random()*20);
	return 15+Math.floor(Math.random()*15);
}
let onlineUsers = getBaseOnline();
function updateOnlineCount() {
	// Small random walk + occasional spikes
	const change = Math.random() < 0.1 ? Math.floor(Math.random()*8)-2 : Math.floor(Math.random()*5)-2;
	onlineUsers += change;
	const base = getBaseOnline();
	if(onlineUsers < base*0.6) onlineUsers = base - Math.floor(Math.random()*5);
	if(onlineUsers > base*1.5) onlineUsers = base + Math.floor(Math.random()*5);
	document.getElementById('online-count').textContent = `● ${onlineUsers} online`;
}
updateOnlineCount();
