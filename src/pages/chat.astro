	}
}

// ==========================================
// 60s RECONNECT TIMER
// ==========================================
let reconnectTimeout = null;
let reconnectCountdown = null;

function startReconnectTimer() {
	addSystemMsg('⏳ Partner disconnected. Waiting 60s for reconnection...');
	let sec = 60;
	const lbl = document.getElementById('call-status-label');
	lbl.textContent = `Reconnecting (${sec}s)`;
	reconnectCountdown = setInterval(() => {
		sec--;
		lbl.textContent = `Reconnecting (${sec}s)`;
		if(sec <= 0) { clearInterval(reconnectCountdown); }
	}, 1000);
	reconnectTimeout = setTimeout(() => {
		clearInterval(reconnectCountdown);
		addSystemMsg('Partner did not reconnect. Finding new match...');
		reMatch();
	}, 60000);
}

function clearReconnectTimer() {
	if(reconnectTimeout) { clearTimeout(reconnectTimeout); reconnectTimeout=null; }
	if(reconnectCountdown) { clearInterval(reconnectCountdown); reconnectCountdown=null; }
	document.getElementById('call-status-label').textContent = chatMode==='voice' ? 'Live Call' : 'Text Chat';
}

// ==========================================
// CHAT MESSAGES
// ==========================================
function sendChat() {
	const text = chatInput.value.trim(); if(!text) return;
	addMyChatMsg(escapeHTML(text));
	chatInput.value = '';
	if(isBotCall) { if(botTimeout)clearTimeout(botTimeout); botReply(1500); }
	else if(ws?.readyState===1&&matchedPeerId) ws.send(JSON.stringify({type:'chat_message',data:{targetPeerId:matchedPeerId,text}}));
}
document.getElementById('send-btn').addEventListener('click', sendChat);
chatInput.addEventListener('keydown', e => { if(e.key==='Enter') sendChat(); });
chatInput.addEventListener('input', () => {
	if(!matchedPeerId||isBotCall) return;
	if(ws?.readyState===1) ws.send(JSON.stringify({type:'typing',data:{targetPeerId:matchedPeerId,isTyping:true}}));
	if(typingTimer) clearTimeout(typingTimer);
	typingTimer = setTimeout(()=>{if(ws?.readyState===1&&matchedPeerId)ws.send(JSON.stringify({type:'typing',data:{targetPeerId:matchedPeerId,isTyping:false}}));},2000);
});

function onRemoteMsg(text) {
	if(text.startsWith('[IMG]') && text.endsWith('[/IMG]')) {
		const src = text.slice(5, -6);
		addRemoteChatMsg(`<img src="${src}" class="max-w-[200px] rounded-lg border border-hairline" alt="Image"/>`, true);
	} else {
		addRemoteChatMsg(escapeHTML(text));
	}
}

function addMyChatMsg(content, isHtml=false) {
	const d = document.createElement('div'); d.className = 'flex flex-col items-end space-y-0.5';
	const time = new Date().toLocaleTimeString([],{hour:'2-digit',minute:'2-digit'});
	d.innerHTML = `<div class="bg-primary text-on-primary py-2.5 px-4 rounded-2xl rounded-br-md max-w-[80%] break-words text-[13px] leading-relaxed shadow-sm">${content}</div><span class="text-[10px] text-stone px-1">You · ${time}</span>`;
	chatMessages.appendChild(d); chatMessages.scrollTop = chatMessages.scrollHeight;
}
function addRemoteChatMsg(content, isHtml=false) {
	const d = document.createElement('div'); d.className = 'flex flex-col items-start space-y-0.5';
	const time = new Date().toLocaleTimeString([],{hour:'2-digit',minute:'2-digit'});
	const handle = document.getElementById('partner-handle').textContent;
	d.innerHTML = `<div class="bg-surface border border-hairline text-ink py-2.5 px-4 rounded-2xl rounded-bl-md max-w-[80%] break-words text-[13px] leading-relaxed shadow-sm">${content}</div><span class="text-[10px] text-stone px-1">${handle} · ${time}</span>`;
	chatMessages.appendChild(d); chatMessages.scrollTop = chatMessages.scrollHeight;
}
function addSystemMsg(text) {
	const d = document.createElement('div'); d.className = 'text-center text-xs text-slate italic bg-surface py-1.5 px-3 rounded-lg';
	d.textContent = text; chatMessages.appendChild(d); chatMessages.scrollTop = chatMessages.scrollHeight;
}
function escapeHTML(s) { return s.replace(/[&<>'"]/g, c=>({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[c]||c)); }

// ==========================================
// BOT
// ==========================================
function startBot() { botSeq=0; botReply(2500); }
function botReply(delay) {
	botTimeout = setTimeout(()=>{
		document.getElementById('typing-indicator').classList.remove('hidden');
		botTimeout = setTimeout(()=>{
			document.getElementById('typing-indicator').classList.add('hidden');
			botSeq++;
			const msgs = ["Hey! How's it going? 👋","What brings you to Airwalk today?","I love that everything here is free — no coins needed!","Try out the games tab! We can play while chatting.","Feel free to skip when you want. It unlocks after 5 seconds."];
			addRemoteChatMsg(escapeHTML(msgs[Math.min(botSeq-1, msgs.length-1)]));
			if(botSeq<5) botReply(5000+Math.random()*3000);
		}, 1200);
	}, delay);
}

// ==========================================
// TABS
// ==========================================
window.switchTab = function(tab) {
	const tc = document.getElementById('tab-chat-btn'), tg = document.getElementById('tab-games-btn');
	if(tab==='chat') {
		tc.className="flex-1 text-center py-3 text-xs font-bold uppercase tracking-wider text-primary border-b-2 border-primary focus:outline-none";
		tg.className="flex-1 text-center py-3 text-xs font-bold uppercase tracking-wider text-slate hover:text-primary focus:outline-none relative";
		document.getElementById('panel-chat').classList.remove('hidden'); document.getElementById('panel-games').classList.add('hidden');
	} else {
		tg.className="flex-1 text-center py-3 text-xs font-bold uppercase tracking-wider text-primary border-b-2 border-primary focus:outline-none relative";
		tc.className="flex-1 text-center py-3 text-xs font-bold uppercase tracking-wider text-slate hover:text-primary focus:outline-none";
		document.getElementById('panel-games').classList.remove('hidden'); document.getElementById('panel-chat').classList.add('hidden');
		document.getElementById('game-dot').classList.add('hidden');
	}
};

// ==========================================
// GAMES ENGINE
// ==========================================
window.startGame = function(type) { mountGame(type, true); };
window.exitGame = function() { currentGame=null;gameActive=false; document.getElementById('game-selector').classList.remove('hidden'); document.getElementById('game-area').classList.add('hidden'); };
window.resetGame = function() { if(currentGame) mountGame(currentGame, true); };

function setStatus(s) { document.getElementById('game-status').textContent = s; }

function mountGame(type, invite=false) {
	currentGame = type; gameActive = true;
	document.getElementById('game-selector').classList.add('hidden');
	document.getElementById('game-area').classList.remove('hidden');
	const board = document.getElementById('game-board');

	if(type==='tictactoe') {
		document.getElementById('game-title').textContent = '❌ Tic-Tac-Toe';
		gameTurn = activeRole==='initiator' ? 'me' : 'them';
		tttBoard = Array(9).fill('');
		board.innerHTML = `<div class="grid grid-cols-3 gap-2 w-60 mx-auto">${Array(9).fill('').map((_,i)=>`<button class="ttt-cell bg-surface hover:bg-cream border border-hairline rounded-xl h-[76px] text-3xl font-bold transition-all" data-i="${i}"></button>`).join('')}</div>`;
		board.querySelectorAll('.ttt-cell').forEach(c => c.addEventListener('click', () => tttMove(+c.dataset.i)));
		setStatus(gameTurn==='me'?'Your turn (X)':"Stranger's turn (O)");
	} else if(type==='rps') {
		document.getElementById('game-title').textContent = '✊ Rock Paper Scissors';
		rpsRound=0; rpsScore={me:0,them:0};
		board.innerHTML = `<div class="text-center space-y-4"><p class="text-sm text-slate">Best of 3 — Pick your move:</p><div class="flex justify-center gap-3"><button class="rps-btn text-4xl p-3 bg-surface border border-hairline rounded-xl hover:bg-cream transition-all" data-m="rock">✊</button><button class="rps-btn text-4xl p-3 bg-surface border border-hairline rounded-xl hover:bg-cream transition-all" data-m="paper">✋</button><button class="rps-btn text-4xl p-3 bg-surface border border-hairline rounded-xl hover:bg-cream transition-all" data-m="scissors">✌️</button></div><p id="rps-result" class="text-sm font-bold text-ink"></p><p id="rps-scores" class="text-xs text-steel">You: 0 | Them: 0</p></div>`;
		board.querySelectorAll('.rps-btn').forEach(b => b.addEventListener('click', () => rpsMove(b.dataset.m)));
		setStatus('Pick your move!');
	} else if(type==='connect4') {
		document.getElementById('game-title').textContent = '🔴 Connect Four';
		gameTurn = activeRole==='initiator' ? 'me' : 'them';
		c4Board = Array(6).fill(null).map(()=>Array(7).fill(''));
		renderC4();
		setStatus(gameTurn==='me'?'Your turn (🔴)':"Stranger's turn (🟡)");
	} else if(type==='wordle') {
		document.getElementById('game-title').textContent = '🟩 Wordle';
		const words = ['BRAVE','CRANE','FLAME','GLOBE','HOUSE','LIGHT','MUSIC','OCEAN','PLANT','SMILE','STONE','TIGER','WORLD','CHAIR','DREAM','FRESH','GRAPE','HONEY','JUDGE','KNIFE','LEMON','MANGO','NERVE','PEACE','QUEEN','RIVER','SOLAR','THINK','URBAN','VOICE','WHEAT','YOUTH','BLAZE','CLOUD','EARTH','FROST','GRAIN','HEART','IMAGE','JOLLY','KNEEL','LUNAR','MAPLE','NIGHT','OLIVE','PIXEL','QUEST','RAPID','SPARK','TRACK'];
		wordleWord = words[Math.floor(Math.random()*words.length)];
		wordleGuesses = [];
		board.innerHTML = `<div class="space-y-4"><div id="wordle-grid" class="space-y-1.5 min-h-[180px]"></div><div class="flex justify-center gap-2"><input id="wordle-input" type="text" maxlength="5" class="w-36 bg-surface border-2 border-hairline rounded-lg px-3 h-10 text-sm uppercase font-bold text-center tracking-widest focus:ring-2 focus:ring-primary focus:border-primary focus:outline-none" placeholder="GUESS"/><button id="wordle-submit" class="bg-primary hover:bg-primary-deep text-on-primary px-5 h-10 rounded-lg font-bold text-sm transition-colors shadow-sm">→</button></div><p class="text-[10px] text-steel text-center">🟩 = correct spot | 🟨 = wrong spot | ⬜ = not in word</p></div>`;
		document.getElementById('wordle-submit').addEventListener('click', wordleGuess);
		document.getElementById('wordle-input').addEventListener('keydown', e => { if(e.key==='Enter') wordleGuess(); });
		setStatus('Guess the 5-letter word! (6 tries)');
	} else if(type==='ludo') {
		document.getElementById('game-title').textContent = '🎲 Ludo Race';
		gameTurn = activeRole==='initiator' ? 'me' : 'them';
		ludoPos = {me:0,them:0};
		board.innerHTML = `<div class="space-y-4"><div class="bg-surface rounded-xl border border-hairline p-4 space-y-3"><div class="flex justify-between text-xs font-bold"><span class="text-primary">🔴 You: <span id="ludo-me">0</span>/16</span><span class="text-blue-500">🔵 Them: <span id="ludo-them">0</span>/16</span></div><div class="h-10 bg-canvas rounded-lg border border-hairline relative"><div class="absolute right-3 top-0 bottom-0 flex items-center text-[9px] font-bold text-accent">🏁</div><div id="ludo-t-me" class="absolute w-6 h-6 bg-primary text-on-primary rounded-full flex items-center justify-center text-[10px] font-bold shadow transition-all duration-500" style="left:2%;top:15%">Y</div><div id="ludo-t-them" class="absolute w-6 h-6 bg-blue-500 text-white rounded-full flex items-center justify-center text-[10px] font-bold shadow transition-all duration-500" style="left:2%;top:45%">T</div></div></div><div class="flex justify-center gap-3"><button id="ludo-roll" class="bg-primary hover:bg-primary-deep text-on-primary font-bold text-sm px-6 py-2.5 rounded-lg shadow transition-all">🎲 Roll</button><div class="bg-surface border border-hairline px-4 py-2.5 rounded-lg"><span class="text-xs text-steel">Roll: </span><span id="ludo-dice" class="text-lg font-bold text-ink">--</span></div></div></div>`;
		document.getElementById('ludo-roll').addEventListener('click', ludoRoll);
		document.getElementById('ludo-roll').disabled = gameTurn!=='me';
		setStatus(gameTurn==='me'?'Roll the dice!':'Stranger rolling...');
	}

	if(invite && ws?.readyState===1 && matchedPeerId) {
		ws.send(JSON.stringify({type:'game_action',data:{targetPeerId:matchedPeerId,gameType:type,action:'invite',payload:{}}}));
	}
}

// --- TIC TAC TOE ---
function tttMove(i) {
	if(!gameActive||gameTurn!=='me'||tttBoard[i]) return;
	tttBoard[i] = 'X';
	renderTTT();
	sendGameAction('tictactoe','move',{i});
	const w = tttCheck();
	if(w) { gameActive=false; setStatus(w==='draw'?'Draw!':'You win! 🎉'); }
	else { gameTurn='them'; setStatus("Stranger's turn"); if(isBotCall) botGameMove(); }
}
function renderTTT() {
	document.querySelectorAll('.ttt-cell').forEach((c,idx) => {
		c.textContent = tttBoard[idx];
		c.style.color = tttBoard[idx]==='X'?'var(--color-primary)':tttBoard[idx]==='O'?'#e74c3c':'';
	});
}
function tttCheck() {
	const w=[[0,1,2],[3,4,5],[6,7,8],[0,3,6],[1,4,7],[2,5,8],[0,4,8],[2,4,6]];
	for(const[a,b,c]of w) if(tttBoard[a]&&tttBoard[a]===tttBoard[b]&&tttBoard[a]===tttBoard[c]) return tttBoard[a];
	return tttBoard.includes('')?null:'draw';
}

// --- ROCK PAPER SCISSORS ---
function rpsMove(move) {
	if(!gameActive) return;
	const botMove = ['rock','paper','scissors'][Math.floor(Math.random()*3)];
	const result = rpsResult(move, botMove);
	rpsRound++;
	if(result==='win') rpsScore.me++;
	else if(result==='lose') rpsScore.them++;
	const icons = {rock:'✊',paper:'✋',scissors:'✌️'};
	document.getElementById('rps-result').textContent = `${icons[move]} vs ${icons[botMove]} — ${result==='win'?'You win!':result==='lose'?'They win!':'Tie!'}`;
	document.getElementById('rps-scores').textContent = `You: ${rpsScore.me} | Them: ${rpsScore.them}`;
	if(rpsScore.me>=2) { gameActive=false; setStatus('You won the match! 🎉'); }
	else if(rpsScore.them>=2) { gameActive=false; setStatus('Stranger won!'); }
	else setStatus(`Round ${rpsRound+1} — Pick!`);
	sendGameAction('rps','move',{move, botMove, result});
}
function rpsResult(a,b) { if(a===b) return 'draw'; if((a==='rock'&&b==='scissors')||(a==='paper'&&b==='rock')||(a==='scissors'&&b==='paper')) return 'win'; return 'lose'; }

// --- CONNECT FOUR ---
function renderC4() {
	const board = document.getElementById('game-board');
	board.innerHTML = `<div class="flex justify-center"><div class="bg-primary/10 border border-primary/20 rounded-xl p-2 inline-block"><div class="grid grid-cols-7 gap-1" id="c4-grid">${c4Board.flat().map((_,idx)=>{const r=Math.floor(idx/7),c=idx%7;const v=c4Board[r][c];return `<div class="w-8 h-8 rounded-full border border-hairline ${v==='R'?'bg-red-500':v==='Y'?'bg-yellow-400':'bg-canvas'} cursor-pointer transition-colors" data-col="${c}"></div>`;}).join('')}</div></div></div>`;
	board.querySelectorAll('[data-col]').forEach(el => el.addEventListener('click', () => c4Drop(+el.dataset.col)));
}
function c4Drop(col) {
	if(!gameActive||gameTurn!=='me') return;
	for(let r=5;r>=0;r--) { if(!c4Board[r][col]) { c4Board[r][col]='R'; break; } else if(r===0) return; }
	renderC4();
	sendGameAction('connect4','move',{col});
	if(c4Check('R')) { gameActive=false; setStatus('You win! 🎉'); }
	else { gameTurn='them'; setStatus("Stranger's turn (🟡)"); if(isBotCall) botGameMove(); }
}
function c4Check(sym) {
	for(let r=0;r<6;r++) for(let c=0;c<7;c++) {
		if(c+3<7&&c4Board[r][c]===sym&&c4Board[r][c+1]===sym&&c4Board[r][c+2]===sym&&c4Board[r][c+3]===sym) return true;
		if(r+3<6&&c4Board[r][c]===sym&&c4Board[r+1][c]===sym&&c4Board[r+2][c]===sym&&c4Board[r+3][c]===sym) return true;
		if(r+3<6&&c+3<7&&c4Board[r][c]===sym&&c4Board[r+1][c+1]===sym&&c4Board[r+2][c+2]===sym&&c4Board[r+3][c+3]===sym) return true;
		if(r-3>=0&&c+3<7&&c4Board[r][c]===sym&&c4Board[r-1][c+1]===sym&&c4Board[r-2][c+2]===sym&&c4Board[r-3][c+3]===sym) return true;
	}
	return false;
}

// --- WORDLE ---
function wordleGuess() {
	if(!gameActive) return;
	const input = document.getElementById('wordle-input');
	if(!input) return;
	const guess = input.value.toUpperCase().trim().replace(/[^A-Z]/g,'');
	if(guess.length!==5) { setStatus('Enter exactly 5 letters!'); return; }
	input.value = '';
	wordleGuesses.push(guess);
	const grid = document.getElementById('wordle-grid');
	const row = document.createElement('div'); row.className = 'flex justify-center gap-1';
	
	// Calculate colors correctly (handle duplicate letters)
	const colors = Array(5).fill('gray');
	const wordArr = wordleWord.split('');
	const used = Array(5).fill(false);
	
	// First pass: exact matches (green)
	for(let i=0;i<5;i++) {
		if(guess[i]===wordArr[i]) { colors[i]='green'; used[i]=true; }
	}
	// Second pass: wrong position (yellow)
	for(let i=0;i<5;i++) {
		if(colors[i]==='green') continue;
		for(let j=0;j<5;j++) {
			if(!used[j]&&guess[i]===wordArr[j]) { colors[i]='yellow'; used[j]=true; break; }
		}
	}
	
	for(let i=0;i<5;i++) {
		const bg = colors[i]==='green' ? 'bg-green-500 text-white' : colors[i]==='yellow' ? 'bg-yellow-400 text-black' : 'bg-slate/30 text-ink';
		row.innerHTML += `<div class="w-10 h-10 ${bg} rounded-lg font-bold text-sm flex items-center justify-center border border-hairline shadow-sm">${guess[i]}</div>`;
	}
	grid.appendChild(row);
	if(guess===wordleWord) { gameActive=false; setStatus('🎉 Correct! Word: ' + wordleWord); }
	else if(wordleGuesses.length>=6) { gameActive=false; setStatus('❌ Game over! Word: ' + wordleWord); }
	else setStatus(`Guess ${wordleGuesses.length+1}/6 — ${6-wordleGuesses.length} left`);
	sendGameAction('wordle','guess',{guess});
}

// --- LUDO ---
function ludoRoll() {
	if(!gameActive||gameTurn!=='me') return;
	const roll = Math.floor(Math.random()*6)+1;
	document.getElementById('ludo-dice').textContent = roll;
	ludoPos.me = Math.min(16, ludoPos.me + roll);
	document.getElementById('ludo-me').textContent = ludoPos.me;
	document.getElementById('ludo-t-me').style.left = `${Math.min(88,(ludoPos.me/16)*88)}%`;
	sendGameAction('ludo','roll',{roll,pos:ludoPos.me});
	if(ludoPos.me>=16) { gameActive=false; setStatus('You won! 🏆'); document.getElementById('ludo-roll').disabled=true; }
	else { gameTurn='them'; setStatus('Stranger rolling...'); document.getElementById('ludo-roll').disabled=true; if(isBotCall) botGameMove(); }
}

// --- GAME COMMS ---
function sendGameAction(type, action, payload) {
	if(ws?.readyState===1&&matchedPeerId) ws.send(JSON.stringify({type:'game_action',data:{targetPeerId:matchedPeerId,gameType:type,action,payload}}));
}

function onGameAction(data) {
	const {gameType, action, payload} = data;
	if(document.getElementById('panel-games').classList.contains('hidden')) { document.getElementById('game-dot').classList.remove('hidden'); addSystemMsg('🎮 Stranger started a game!'); }
	if(currentGame!==gameType) mountGame(gameType, false);

	if(gameType==='tictactoe'&&action==='move') {
		tttBoard[payload.i]='O'; renderTTT();
		const w=tttCheck(); if(w){gameActive=false;setStatus(w==='draw'?'Draw!':'Stranger wins!');} else{gameTurn='me';setStatus('Your turn');}
	} else if(gameType==='connect4'&&action==='move') {
		for(let r=5;r>=0;r--) { if(!c4Board[r][payload.col]){c4Board[r][payload.col]='Y';break;} }
		renderC4(); if(c4Check('Y')){gameActive=false;setStatus('Stranger wins!');} else{gameTurn='me';setStatus('Your turn (🔴)');}
	} else if(gameType==='ludo'&&action==='roll') {
		ludoPos.them=payload.pos; document.getElementById('ludo-them').textContent=ludoPos.them;
		document.getElementById('ludo-t-them').style.left=`${Math.min(88,(ludoPos.them/16)*88)}%`;
		document.getElementById('ludo-dice').textContent=payload.roll;
		if(ludoPos.them>=16){gameActive=false;setStatus('Stranger won!');} else{gameTurn='me';setStatus('Roll the dice!');document.getElementById('ludo-roll').disabled=false;}
	}
}

// Bot game moves
function botGameMove() {
	if(!isBotCall||!gameActive||gameTurn!=='them') return;
	setStatus('Stranger thinking...');
	setTimeout(()=>{
		if(!gameActive||gameTurn!=='them') return;
		if(currentGame==='tictactoe') {
			const avail=tttBoard.map((v,i)=>v===''?i:-1).filter(i=>i!==-1);
			if(avail.length) { const i=avail[Math.floor(Math.random()*avail.length)]; tttBoard[i]='O'; renderTTT(); const w=tttCheck(); if(w){gameActive=false;setStatus(w==='draw'?'Draw!':'Stranger wins!');}else{gameTurn='me';setStatus('Your turn');} }
		} else if(currentGame==='connect4') {
			const cols=[];for(let c=0;c<7;c++){if(!c4Board[0][c])cols.push(c);}
			if(cols.length){const col=cols[Math.floor(Math.random()*cols.length)];for(let r=5;r>=0;r--){if(!c4Board[r][col]){c4Board[r][col]='Y';break;}}renderC4();if(c4Check('Y')){gameActive=false;setStatus('Stranger wins!');}else{gameTurn='me';setStatus('Your turn (🔴)');}}
		} else if(currentGame==='ludo') {
			const roll=Math.floor(Math.random()*6)+1;ludoPos.them=Math.min(16,ludoPos.them+roll);
			document.getElementById('ludo-them').textContent=ludoPos.them;document.getElementById('ludo-t-them').style.left=`${Math.min(88,(ludoPos.them/16)*88)}%`;document.getElementById('ludo-dice').textContent=roll;
			if(ludoPos.them>=16){gameActive=false;setStatus('Stranger won!');}else{gameTurn='me';setStatus('Roll the dice!');document.getElementById('ludo-roll').disabled=false;}
		}
	}, 1000+Math.random()*800);
}

