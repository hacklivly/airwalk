let drawCtx = null;
let isDrawing = false;
function initCanvas() {
	const canvas = document.getElementById('draw-canvas');
	if(!canvas) return;
	drawCtx = canvas.getContext('2d');
	drawCtx.strokeStyle = '#1877f2';
	drawCtx.lineWidth = 3;
	drawCtx.lineCap = 'round';
	canvas.addEventListener('pointerdown', e => { isDrawing=true; drawCtx.beginPath(); drawCtx.moveTo(e.offsetX, e.offsetY); });
	canvas.addEventListener('pointermove', e => { if(!isDrawing) return; drawCtx.lineTo(e.offsetX, e.offsetY); drawCtx.stroke(); });
	canvas.addEventListener('pointerup', () => { isDrawing=false; });
	canvas.addEventListener('pointerleave', () => { isDrawing=false; });
}
