	addMyChatMsg(imgHtml, true);
	if(ws?.readyState===1&&matchedPeerId) ws.send(JSON.stringify({type:'chat_message',data:{targetPeerId:matchedPeerId,text:`[IMG]${url}[/IMG]`}}));
