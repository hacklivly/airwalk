	const btn = document.getElementById(`mode-${mode}`);
	if(mode==='mystery') btn.className = 'special-mode-btn bg-purple-100 border-2 border-purple-400 text-purple-700 rounded-lg p-2 text-center text-[11px] font-semibold';
	else if(mode==='speed') btn.className = 'special-mode-btn bg-pink-100 border-2 border-pink-400 text-pink-700 rounded-lg p-2 text-center text-[11px] font-semibold';
	else if(mode==='night') btn.className = 'special-mode-btn bg-indigo-100 border-2 border-indigo-400 text-indigo-700 rounded-lg p-2 text-center text-[11px] font-semibold';
};

window.setMood = function(mood) {
	userMood = mood;
	document.querySelectorAll('.mood-btn').forEach(btn => {
		btn.className = 'mood-btn bg-surface border border-hairline rounded-full px-3 py-1 text-xs font-medium transition-all hover:bg-primary-light hover:border-primary hover:text-primary';
	});
	event.target.className = 'mood-btn bg-primary text-on-primary border-2 border-primary rounded-full px-3 py-1 text-xs font-medium';
};

// Night Owl / After Dark mode - auto-activate after midnight
(function() {
	const hour = new Date().getHours();
	if(hour >= 23 || hour < 5) {
		document.body.style.background = 'linear-gradient(135deg, #0f0c29, #302b63, #24243e)';
		addSystemMsg('🌙 After Dark mode is active! Late night vibes...');
		specialMode = 'night';
	}
})();

// Mystery mode: hide partner info for first 2 min
const _origOnMatched2 = onMatched;
onMatched = function(data) {
	_origOnMatched2(data);
	if(specialMode === 'mystery') {
		document.getElementById('partner-handle').textContent = '???';
		document.getElementById('partner-avatar').textContent = '🎭';
		document.getElementById('partner-country').textContent = '🌍 ???';
		document.getElementById('partner-lang').textContent = '???';
		addSystemMsg('🎭 Mystery Mode: Partner info reveals in 2 minutes...');
		setTimeout(() => {
			const pi = data.peerInfo;
			document.getElementById('partner-handle').textContent = pi.name || pi.handle || 'Stranger';
			document.getElementById('partner-avatar').textContent = pi.avatar || '🐻';
			document.getElementById('partner-country').textContent = `🌍 ${pi.country}`;
			const gi = pi.gender==='Female'?'♀':pi.gender==='Male'?'♂':'⚧';
			document.getElementById('partner-lang').textContent = `${gi} ${pi.gender||'--'} • ${pi.age||'--'}yo • ${pi.language}`;
			addSystemMsg('✨ Partner revealed!');
		}, 120000);
	}
	if(specialMode === 'speed') {
		addSystemMsg('⚡ Speed Dating: You have 60 seconds! Make it count!');
		setTimeout(() => { if(matchedPeerId) { addSystemMsg('⏰ Time\'s up! Moving to next...'); reMatch(); } }, 60000);
	}
	if(userMood) addSystemMsg(`💭 Your mood: ${userMood}`);
};

// ==========================================
// KARMA SCORE
// ==========================================
function getKarma() { return parseInt(localStorage.getItem('airwalk_karma')||'100'); }
function addKarma(pts) { const k = Math.max(0, Math.min(200, getKarma()+pts)); localStorage.setItem('airwalk_karma', k); return k; }
// Good behavior = karma up, reports = karma down
const _origAddFriend2 = addFriend;
addFriend = function() { _origAddFriend2(); addKarma(5); };

// ==========================================
// COINS & REFERRAL SYSTEM
// ==========================================
function getCoins() { return parseInt(localStorage.getItem('airwalk_coins')||'0'); }
function addCoins(n) { const c = getCoins()+n; localStorage.setItem('airwalk_coins', c); return c; }

// Earn coins: 1 coin per minute of call
setInterval(() => { if(matchedPeerId && callStart) { addCoins(1); } }, 60000);

// Referral
function getReferralCode() {
	let code = localStorage.getItem('airwalk_referral');
	if(!code) { code = 'AW-' + Math.random().toString(36).substr(2,6).toUpperCase(); localStorage.setItem('airwalk_referral', code); }
	return code;
}

// Update invite to show referral + coins
const _origShareInvite = window.shareInvite;
window.shareInvite = function() {
	const code = getReferralCode();
	const coins = getCoins();
	const link = `https://airwalk.pages.dev/chat?ref=${code}`;
	const text = `Join me on Airwalk! Free voice & text chat 🎙️ Use my code: ${code}\n${link}`;
	if(navigator.share) navigator.share({title:'Airwalk',text,url:link});
	else { navigator.clipboard.writeText(text); alert(`Invite copied! Your code: ${code}\n💰 You have ${coins} coins`); }
};

// Check referral on load
(function() {
	const params = new URLSearchParams(window.location.search);
	const ref = params.get('ref');
	if(ref && !localStorage.getItem('airwalk_referred')) {
		localStorage.setItem('airwalk_referred', ref);
		addCoins(10);
		setTimeout(() => addSystemMsg('🎁 Welcome bonus: +10 coins for joining via referral!'), 3000);
	}
})();

// Hook mountGame for new games
const _origMountGame = mountGame;
mountGame = function(type, invite) {
	if(['truthdare','wouldyou','songguess','quickdraw'].includes(type)) {
		currentGame = type; gameActive = true;
		document.getElementById('game-selector').classList.add('hidden');
		document.getElementById('game-area').classList.remove('hidden');
		const board = document.getElementById('game-board');
		mountNewGames(type, board);
		if(invite && ws?.readyState===1 && matchedPeerId) ws.send(JSON.stringify({type:'game_action',data:{targetPeerId:matchedPeerId,gameType:type,action:'invite',payload:{}}}));
		const s = getStats(); s.games=(s.games||0)+1; localStorage.setItem('airwalk_stats',JSON.stringify(s));
	} else {
		_origMountGame(type, invite);
	}
};

