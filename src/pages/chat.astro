function connectWS() {
	if (ws?.readyState === WebSocket.OPEN) { sendJoin(); return; }
	// Production: connect to Cloudflare Worker signaling server
	// Local dev: connect to localhost:3001
	const isLocal = location.hostname === 'localhost' || location.hostname === '127.0.0.1';
	const wsUrl = isLocal
		? `ws://${location.hostname}:3001`
		: 'wss://airwalk-signal.airwalkhq.workers.dev';
	ws = new WebSocket(wsUrl);
	ws.onopen = () => { document.getElementById('online-indicator').textContent = '🟢 Online'; sendJoin(); };
	ws.onmessage = async (e) => {
		const msg = JSON.parse(e.data);
		switch(msg.type) {
			case 'matched': onMatched(msg.data); break;
			case 'offer': await onOffer(msg.data); break;
			case 'answer': if(pc) await pc.setRemoteDescription(new RTCSessionDescription(msg.data)); break;
			case 'candidate': if(pc) await pc.addIceCandidate(new RTCIceCandidate(msg.data)); break;
			case 'chat_message': onRemoteMsg(msg.data.text); break;
			case 'typing': msg.data.isTyping ? document.getElementById('typing-indicator').classList.remove('hidden') : document.getElementById('typing-indicator').classList.add('hidden'); break;
			case 'game_action': onGameAction(msg.data); break;
			case 'mute_status': showMuteIndicator(msg.data.isMuted); break;
			case 'skipped': addSystemMsg('Partner skipped.'); reMatch(); break;
			case 'disconnected': startReconnectTimer(); break;
			case 'reconnected': clearReconnectTimer(); addSystemMsg('Partner reconnected!'); break;
		}
	};
	ws.onclose = () => { document.getElementById('online-indicator').textContent = '🔴 Offline'; };
}

function sendJoin() {
	const lang = document.getElementById('language-filter').value;
	const country = document.getElementById('country-filter').value;
	const tags = document.getElementById('interest-input').value.split(',').map(t=>t.trim()).filter(Boolean);
	const handle = localStorage.getItem('airwalk_handle');
	const avatar = localStorage.getItem('airwalk_avatar');
	const name = document.getElementById('user-name').value.trim() || handle;
	const age = parseInt(document.getElementById('user-age').value) || 18;
	const gender = document.getElementById('user-gender').value;
	localStorage.setItem('airwalk_name', name);
	localStorage.setItem('airwalk_age', age);
	localStorage.setItem('airwalk_gender', gender);
	localStorage.setItem('airwalk_language', lang);
	localStorage.setItem('airwalk_country', country);
	localStorage.setItem('airwalk_interests', document.getElementById('interest-input').value);
	ws.send(JSON.stringify({ type: 'join', data: { id: myClientId, language: lang, country, tags, handle, avatar, chatMode, name, age, gender } }));
}

function onMatched(data) {
	matchedPeerId = data.peerId;
	activeRole = data.role;
	isBotCall = !!data.isBot;
	const pi = data.peerInfo;

	document.getElementById('partner-handle').textContent = pi.name || pi.handle || 'Stranger';
	document.getElementById('partner-avatar').textContent = pi.avatar || '🐻';
	document.getElementById('partner-country').textContent = `🌍 ${pi.country}`;
	const genderIcon = pi.gender === 'Female' ? '♀' : pi.gender === 'Male' ? '♂' : '⚧';
	document.getElementById('partner-lang').textContent = `${genderIcon} ${pi.gender || '--'} • ${pi.age || '--'}yo • ${pi.language}`;
	document.getElementById('partner-tags').innerHTML = (pi.tags||[]).map(t => `<span class="text-[10px] bg-primary/10 text-primary px-2 py-0.5 rounded-full">#${t}</span>`).join('');

	// Show/hide voice UI
	if (chatMode === 'voice') {
		document.getElementById('eq-section').classList.remove('hidden');
		document.getElementById('text-mode-info').classList.add('hidden');
		document.getElementById('mute-btn').classList.remove('hidden');
		document.getElementById('call-status-label').textContent = 'Live Call';
	} else {
		document.getElementById('eq-section').classList.add('hidden');
		document.getElementById('text-mode-info').classList.remove('hidden');
		document.getElementById('mute-btn').classList.add('hidden');
		document.getElementById('call-status-label').textContent = 'Text Chat';
	}

	chatMessages.innerHTML = '<div class="text-center text-xs text-slate italic bg-surface py-1.5 px-3 rounded-lg">Connected! Say hello 👋</div>';
	switchTab('chat');
	exitGame();
	matchingScreen.classList.add('hidden');
	callScreen.classList.remove('hidden');
	startTimer();
	startSkipCooldown();
	if (chatMode === 'voice') startEq();
	if (isBotCall) startBot();
	else if (chatMode === 'voice') startWebRTC();
}

// WebRTC
async function startWebRTC() {
	pc = new RTCPeerConnection(iceConfig);
	pc.onicecandidate = e => { if(e.candidate && ws?.readyState===1) ws.send(JSON.stringify({type:'candidate',targetPeerId:matchedPeerId,data:e.candidate})); };
	pc.ontrack = e => { document.getElementById('remote-audio').srcObject = e.streams[0]; };
	if(localStream) localStream.getTracks().forEach(t => pc.addTrack(t, localStream));
	if(activeRole==='initiator') { const o = await pc.createOffer(); await pc.setLocalDescription(o); ws.send(JSON.stringify({type:'offer',targetPeerId:matchedPeerId,data:o})); }
}
async function onOffer(offer) {
	if(isBotCall) return;
	pc = new RTCPeerConnection(iceConfig);
	pc.onicecandidate = e => { if(e.candidate && ws?.readyState===1) ws.send(JSON.stringify({type:'candidate',targetPeerId:matchedPeerId,data:e.candidate})); };
	pc.ontrack = e => { document.getElementById('remote-audio').srcObject = e.streams[0]; };
	if(localStream) localStream.getTracks().forEach(t => pc.addTrack(t, localStream));
	await pc.setRemoteDescription(new RTCSessionDescription(offer));
	const a = await pc.createAnswer(); await pc.setLocalDescription(a);
	ws.send(JSON.stringify({type:'answer',targetPeerId:matchedPeerId,data:a}));
}

// Timer & EQ
let callStart = 0;
function startTimer() { callStart = Date.now(); callTimerInterval = setInterval(() => { const s=Math.floor((Date.now()-callStart)/1000); document.getElementById('call-timer').textContent=`${String(Math.floor(s/60)).padStart(2,'0')}:${String(s%60).padStart(2,'0')}`; }, 1000); }
function stopTimer() { if(callTimerInterval){clearInterval(callTimerInterval);callTimerInterval=null;} document.getElementById('call-timer').textContent='00:00'; }
let eqInt = null;
function startEq() { eqInt = setInterval(()=>{eqBars.forEach(b=>{b.style.height=`${Math.random()*80+10}px`;});},150); }
function stopEq() { if(eqInt){clearInterval(eqInt);eqInt=null;} eqBars.forEach(b=>{b.style.height='12px';}); }
function startSkipCooldown() {
	const btn = document.getElementById('skip-btn'); const lbl = document.getElementById('skip-btn-label');
	btn.disabled=true; let c=20; lbl.textContent=`Skip (${c}s)`;
	skipInterval = setInterval(()=>{ c--; if(c>0) lbl.textContent=`Skip (${c}s)`; else{clearInterval(skipInterval);btn.disabled=false;lbl.textContent='Skip';} },1000);
}

function getCallDuration() { return document.getElementById('call-timer').textContent; }
function cleanup() { stopTimer(); stopEq(); if(pc){pc.close();pc=null;} document.getElementById('remote-audio').srcObject=null; if(botTimeout)clearTimeout(botTimeout); matchedPeerId=null;activeRole=null;isBotCall=false;botSeq=0;exitGame(); }
function reMatch() { const dur = getCallDuration(); if(dur!=='00:00') saveHistory(dur); cleanup(); callScreen.classList.add('hidden'); matchingScreen.classList.remove('hidden'); sendJoin(); }

