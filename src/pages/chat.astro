<script is:inline>
// ==========================================
// THEME TOGGLE
// ==========================================
const themeToggle = document.getElementById('theme-toggle');
function updateThemeIcons() {
	const d = document.documentElement.classList.contains('dark');
	document.querySelectorAll('.dark-icon').forEach(el => el.style.display = d ? 'block' : 'none');
	document.querySelectorAll('.light-icon').forEach(el => el.style.display = d ? 'none' : 'block');
}
updateThemeIcons();
themeToggle.addEventListener('click', () => {
	document.documentElement.classList.toggle('dark');
	localStorage.setItem('theme', document.documentElement.classList.contains('dark') ? 'dark' : 'light');
	updateThemeIcons();
});

// ==========================================
// SEARCHABLE LANGUAGE & COUNTRY DROPDOWNS
// ==========================================
const languages = ['English','Spanish','French','German','Hindi','Portuguese','Arabic','Japanese','Korean','Chinese','Russian','Italian','Dutch','Turkish','Polish','Swedish','Thai','Vietnamese','Indonesian','Malay','Bengali','Tamil','Telugu','Urdu','Persian','Hebrew','Greek','Czech','Romanian','Hungarian','Danish','Norwegian','Finnish','Ukrainian','Tagalog','Swahili','Amharic','Burmese','Khmer','Lao','Nepali','Sinhala','Pashto','Yoruba','Zulu','Afrikaans','Catalan','Serbian','Croatian','Bulgarian','Slovak','Slovenian','Lithuanian','Latvian','Estonian','Icelandic','Maltese','Albanian','Macedonian','Georgian','Armenian','Azerbaijani','Kazakh','Uzbek','Mongolian','Tibetan'];

const countries = ['Worldwide','Afghanistan','Albania','Algeria','Andorra','Angola','Argentina','Armenia','Australia','Austria','Azerbaijan','Bahamas','Bahrain','Bangladesh','Barbados','Belarus','Belgium','Belize','Benin','Bhutan','Bolivia','Bosnia','Botswana','Brazil','Brunei','Bulgaria','Burkina Faso','Burundi','Cambodia','Cameroon','Canada','Chad','Chile','China','Colombia','Congo','Costa Rica','Croatia','Cuba','Cyprus','Czech Republic','Denmark','Dominican Republic','Ecuador','Egypt','El Salvador','Estonia','Ethiopia','Fiji','Finland','France','Gabon','Georgia','Germany','Ghana','Greece','Guatemala','Guinea','Haiti','Honduras','Hungary','Iceland','India','Indonesia','Iran','Iraq','Ireland','Israel','Italy','Jamaica','Japan','Jordan','Kazakhstan','Kenya','Kuwait','Kyrgyzstan','Laos','Latvia','Lebanon','Libya','Lithuania','Luxembourg','Madagascar','Malawi','Malaysia','Maldives','Mali','Malta','Mexico','Moldova','Monaco','Mongolia','Montenegro','Morocco','Mozambique','Myanmar','Namibia','Nepal','Netherlands','New Zealand','Nicaragua','Niger','Nigeria','North Korea','North Macedonia','Norway','Oman','Pakistan','Palestine','Panama','Papua New Guinea','Paraguay','Peru','Philippines','Poland','Portugal','Qatar','Romania','Russia','Rwanda','Saudi Arabia','Senegal','Serbia','Sierra Leone','Singapore','Slovakia','Slovenia','Somalia','South Africa','South Korea','Spain','Sri Lanka','Sudan','Sweden','Switzerland','Syria','Taiwan','Tajikistan','Tanzania','Thailand','Togo','Trinidad and Tobago','Tunisia','Turkey','Turkmenistan','Uganda','Ukraine','United Arab Emirates','United Kingdom','United States','Uruguay','Uzbekistan','Venezuela','Vietnam','Yemen','Zambia','Zimbabwe'];

function setupSearchDropdown(inputId, hidddenId, dropdownId, items) {
	const input = document.getElementById(inputId);
	const hidden = document.getElementById(hidddenId);
	const dropdown = document.getElementById(dropdownId);

	input.value = hidden.value;

	function render(filter) {
		const filtered = items.filter(i => i.toLowerCase().includes(filter.toLowerCase()));
		if (!filtered.length) { dropdown.classList.add('hidden'); return; }
		dropdown.innerHTML = filtered.slice(0, 30).map(i => `<div class="px-3 py-2 text-sm text-ink hover:bg-primary-light hover:text-primary cursor-pointer transition-colors" data-val="${i}">${i}</div>`).join('');
		dropdown.classList.remove('hidden');
		dropdown.querySelectorAll('[data-val]').forEach(el => {
			el.addEventListener('mousedown', (e) => {
				e.preventDefault();
				input.value = el.dataset.val;
				hidden.value = el.dataset.val;
				dropdown.classList.add('hidden');
			});
		});
	}

	input.addEventListener('focus', () => render(input.value));
	input.addEventListener('input', () => render(input.value));
	input.addEventListener('blur', () => { setTimeout(() => dropdown.classList.add('hidden'), 150); });
}

setupSearchDropdown('language-search', 'language-filter', 'language-dropdown', languages);
setupSearchDropdown('country-search', 'country-filter', 'country-dropdown', countries);

// ==========================================
// ANONYMOUS HANDLES & AVATARS
// ==========================================
const animals = ['🦊','🐻','🐼','🦁','🐯','🦄','🐺','🦉','🐙','🦎','🐬','🦖','🐸','🦋','🐝'];
const adjectives = ['Cool','Swift','Brave','Clever','Lucky','Happy','Mystic','Silent','Wild','Noble','Cosmic','Neon'];
const nouns = ['Fox','Bear','Wolf','Eagle','Tiger','Panda','Shark','Phoenix','Dragon','Owl','Cat','Rabbit'];

function generateHandle() {
	const adj = adjectives[Math.floor(Math.random() * adjectives.length)];
	const noun = nouns[Math.floor(Math.random() * nouns.length)];
	const num = Math.floor(Math.random() * 900) + 100;
	const avatar = animals[Math.floor(Math.random() * animals.length)];
	const handle = `${adj}${noun}${num}`;
	document.getElementById('my-handle').textContent = handle;
	document.getElementById('my-avatar').textContent = avatar;
	localStorage.setItem('airwalk_handle', handle);
	localStorage.setItem('airwalk_avatar', avatar);
	return { handle, avatar };
}

// Load or generate handle
if (!localStorage.getItem('airwalk_handle')) generateHandle();
else {
	document.getElementById('my-handle').textContent = localStorage.getItem('airwalk_handle');
	document.getElementById('my-avatar').textContent = localStorage.getItem('airwalk_avatar') || '🦊';
}

// ==========================================
// STATE
// ==========================================
let chatMode = 'voice'; // 'voice' | 'text'
let localStream = null;
let ws = null;
let pc = null;
let myClientId = 'p_' + Math.random().toString(36).substr(2, 9);
let matchedPeerId = null;
let activeRole = null;
let isBotCall = false;
let isMuted = false;
let callTimerInterval = null;
let skipInterval = null;
let typingTimer = null;
let botTimeout = null;
let botSeq = 0;
let friends = JSON.parse(localStorage.getItem('airwalk_friends') || '[]');
let callHistory = JSON.parse(localStorage.getItem('airwalk_history') || '[]');

// Game state
let currentGame = null;
let gameActive = false;
let gameTurn = null;
let tttBoard = Array(9).fill('');
let rpsRound = 0, rpsScore = { me: 0, them: 0 };
let c4Board = Array(6).fill(null).map(() => Array(7).fill(''));
let wordleWord = '', wordleGuesses = [];
let ludoPos = { me: 0, them: 0 };

const iceConfig = { iceServers: [{ urls: 'stun:stun.l.google.com:19302' }] };

// DOM refs
const setupScreen = document.getElementById('setup-screen');
const matchingScreen = document.getElementById('matching-screen');
const callScreen = document.getElementById('call-screen');
const chatMessages = document.getElementById('chat-messages');
const chatInput = document.getElementById('chat-input');
const eqBars = document.querySelectorAll('.eq-bar');

// ==========================================
// CHAT MODE
// ==========================================
window.setChatMode = function(mode) {
	chatMode = mode;
	document.getElementById('mode-voice').className = mode === 'voice'
		? 'bg-primary text-on-primary border-2 border-primary rounded-lg p-3 text-center font-bold text-sm transition-all'
		: 'bg-surface text-ink border-2 border-hairline rounded-lg p-3 text-center font-bold text-sm transition-all hover:border-primary';
	document.getElementById('mode-text').className = mode === 'text'
		? 'bg-primary text-on-primary border-2 border-primary rounded-lg p-3 text-center font-bold text-sm transition-all'
		: 'bg-surface text-ink border-2 border-hairline rounded-lg p-3 text-center font-bold text-sm transition-all hover:border-primary';
};

// ==========================================
// FRIENDS & HISTORY
// ==========================================
document.getElementById('friends-toggle').addEventListener('click', () => {
	document.getElementById('history-panel').classList.add('hidden');
	document.getElementById('friends-panel').classList.toggle('hidden');
	renderFriends();
});
document.getElementById('history-toggle').addEventListener('click', () => {
	document.getElementById('friends-panel').classList.add('hidden');
	document.getElementById('history-panel').classList.toggle('hidden');
	renderHistory();
});

function renderFriends() {
	const list = document.getElementById('friends-list');
	if (!friends.length) { list.innerHTML = '<p class="text-sm text-steel text-center py-8">No friends yet. Add people you connect with!</p>'; return; }
	list.innerHTML = friends.map((f, idx) => `
		<div class="flex items-center space-x-3 p-3 bg-surface border border-hairline rounded-xl">
			<span class="text-lg">${f.avatar}</span>
			<div class="flex-grow"><p class="font-bold text-sm text-ink">${f.handle}</p><p class="text-[10px] text-steel">${f.country} • ${f.lang}</p></div>
			<button onclick="reconnectTo('${f.handle}')" class="text-[10px] bg-primary text-on-primary px-2 py-1 rounded font-bold">Connect</button>
			<button onclick="removeFriend(${idx})" class="text-[10px] text-red-500 px-1">✕</button>
		</div>
	`).join('');
}

function renderHistory() {
	const list = document.getElementById('history-list');
	if (!callHistory.length) { list.innerHTML = '<p class="text-sm text-steel text-center py-8">No history yet.</p>'; return; }
	list.innerHTML = callHistory.slice(-20).reverse().map(h => `
		<div class="flex items-center space-x-3 p-3 bg-surface border border-hairline rounded-xl">
			<span class="text-lg">${h.avatar}</span>
			<div class="flex-grow"><p class="font-bold text-sm text-ink">${h.handle}</p><p class="text-[10px] text-steel">${h.duration} • ${h.date}</p></div>
			<button onclick="reconnectTo('${h.handle}')" class="text-[10px] bg-primary text-on-primary px-2 py-1 rounded font-bold">Recall</button>
		</div>
	`).join('');
}

window.reconnectTo = async function(handle) {
	document.getElementById('friends-panel').classList.add('hidden');
	document.getElementById('history-panel').classList.add('hidden');
	
	const ok = await initAudio();
	if (!ok) return;

	setupScreen.classList.add('hidden');
	callScreen.classList.add('hidden');
	matchingScreen.classList.remove('hidden');
	document.getElementById('search-mode-label').textContent = `Calling ${handle}...`;
	document.getElementById('search-icon').textContent = '📞';
	document.getElementById('search-details').innerHTML = `<p class="text-center text-ink">Ringing <strong>${handle}</strong>...</p>`;

	// Ensure WS is connected, then send reconnect
	if (ws?.readyState === WebSocket.OPEN) {
		sendJoin(); // Register ourselves first
		setTimeout(() => {
			ws.send(JSON.stringify({ type: 'reconnect', data: { targetHandle: handle } }));
		}, 200);
	} else {
		window.reconnectTarget = handle;
		connectWS();
	}
};

window.sendReconnect = function(handle) {
	const lang = document.getElementById('language-filter').value;
	const country = document.getElementById('country-filter').value;
	const tags = document.getElementById('interest-input').value.split(',').map(t=>t.trim()).filter(Boolean);
	const myHandle = localStorage.getItem('airwalk_handle');
	const avatar = localStorage.getItem('airwalk_avatar');
	const name = document.getElementById('user-name').value.trim() || myHandle;
	const age = parseInt(document.getElementById('user-age').value) || 18;
	const gender = document.getElementById('user-gender').value;
	const status = document.getElementById('user-status')?.value?.trim() || '';

	ws.send(JSON.stringify({ type: 'join', data: { id: myClientId, language: lang, country, tags, handle: myHandle, avatar, chatMode, name, age, gender, status } }));
	setTimeout(() => {
		ws.send(JSON.stringify({ type: 'reconnect', data: { targetHandle: handle } }));
	}, 200);
};

window.removeFriend = function(idx) {
	friends.splice(idx, 1);
	localStorage.setItem('airwalk_friends', JSON.stringify(friends));
	renderFriends();
};

function addFriend() {
	if (!matchedPeerId) return;
	const handle = document.getElementById('partner-handle').textContent;
	const avatar = document.getElementById('partner-avatar').textContent;
	const country = document.getElementById('partner-country').textContent;
	const lang = document.getElementById('partner-lang').textContent;
	if (friends.find(f => f.handle === handle)) { addSystemMsg('Already in friends list!'); return; }
	friends.push({ handle, avatar, country, lang, peerId: matchedPeerId, added: new Date().toISOString() });
	localStorage.setItem('airwalk_friends', JSON.stringify(friends));
	// Notify partner
	if(ws?.readyState===1) ws.send(JSON.stringify({type:'chat_message',data:{targetPeerId:matchedPeerId,text:'[SYSTEM] sent you a friend request! 🤝'}}));
	addSystemMsg(`${handle} added to friends! 🤝`);
}

function saveHistory(duration) {
	const handle = document.getElementById('partner-handle').textContent;
	const avatar = document.getElementById('partner-avatar').textContent;
	callHistory.push({ handle, avatar, duration, date: new Date().toLocaleString() });
	localStorage.setItem('airwalk_history', JSON.stringify(callHistory.slice(-50)));
}

document.getElementById('add-friend-btn').addEventListener('click', addFriend);

