---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Airwalk Chat | Talk to Strangers — Free Voice & Text Chat" description="Start chatting with random strangers instantly. Voice or text, your choice. Free gender & country filters, games, friends system.">
	<!-- Header -->
	<header class="bg-canvas/80 backdrop-blur-xl border-b border-hairline h-14 flex items-center justify-between px-4 md:px-6 sticky top-0 z-40">
		<a href="/" class="flex items-center space-x-2 text-ink">
			<svg class="w-7 h-7 text-primary" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2z"/></svg>
			<span class="font-sans font-extrabold text-lg tracking-tight uppercase">Airwalk</span>
		</a>
		<div class="flex items-center space-x-1.5 sm:space-x-2">
			<span class="text-[10px] text-accent font-bold bg-accent/10 px-1.5 py-0.5 rounded-full hidden md:inline-block" id="online-count">● 0 online</span>
			<button id="friends-toggle" class="relative w-8 h-8 sm:w-9 sm:h-9 flex items-center justify-center rounded-full bg-surface border border-hairline hover:bg-cream transition-colors" title="Friends">
				<svg class="w-4 h-4 text-ink" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/></svg>
				<span id="friend-badge" class="hidden absolute -top-0.5 -right-0.5 w-4 h-4 bg-primary text-on-primary text-[9px] font-bold rounded-full flex items-center justify-center">0</span>
			</button>
			<button id="history-toggle" class="w-8 h-8 sm:w-9 sm:h-9 flex items-center justify-center rounded-full bg-surface border border-hairline hover:bg-cream transition-colors hidden sm:flex" title="Call History">
				<svg class="w-4 h-4 text-ink" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
			</button>
			<button id="chat-theme-btn" class="w-8 h-8 sm:w-9 sm:h-9 flex items-center justify-center rounded-full bg-surface border border-hairline hover:bg-cream transition-colors hidden sm:flex" title="Chat Theme">
				<svg class="w-4 h-4 text-ink" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01"/></svg>
			</button>
			<button id="theme-toggle" class="w-8 h-8 sm:w-9 sm:h-9 flex items-center justify-center rounded-full bg-surface border border-hairline hover:bg-cream transition-colors" aria-label="Toggle theme">
				<svg class="w-4 h-4 text-yellow-saturated hidden dark-icon" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l.707.707a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 1.414zm2.12-10.607a1 1 0 010 1.414l-.706.707a1 1 0 11-1.414-1.414l.707-.707a1 1 0 011.414 0zM17 11a1 1 0 100-2h-1a1 1 0 100 2h1zm-7 4a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM5.05 6.464A1 1 0 106.465 5.05l-.708-.707a1 1 0 00-1.414 1.414l.707.707zm1.414 8.486l-.707.707a1 1 0 01-1.414-1.414l.707-.707a1 1 0 011.414 1.414zM4 11a1 1 0 100-2H3a1 1 0 000 2h1z" clip-rule="evenodd"/></svg>
				<svg class="w-4 h-4 text-slate light-icon" fill="currentColor" viewBox="0 0 20 20"><path d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z"/></svg>
			</button>
			<span class="text-xs font-mono text-slate bg-surface px-2 py-1 rounded-md hidden sm:block" id="online-indicator">🟢 Online</span>
		</div>
	</header>

	<main class="flex-grow flex flex-col bg-gradient-to-br from-surface via-canvas to-surface relative">
		<!-- Alert Banner -->
		<div id="alert-banner" class="hidden bg-primary-deep text-on-primary py-2 px-6 text-center text-sm font-semibold flex items-center justify-center space-x-2 z-50">
			<span id="alert-message"></span>
			<button class="bg-black/20 hover:bg-black/35 px-2 py-0.5 rounded text-xs" onclick="document.getElementById('alert-banner').classList.add('hidden')">✕</button>
		</div>

		<!-- Friends Panel (Side Drawer) -->
		<div id="friends-panel" class="hidden fixed inset-y-0 right-0 w-full sm:w-80 bg-canvas border-l border-hairline shadow-2xl z-50 flex flex-col">
			<div class="p-4 border-b border-hairline flex items-center justify-between">
				<h3 class="font-bold text-ink">Friends</h3>
				<button onclick="document.getElementById('friends-panel').classList.add('hidden')" class="text-slate hover:text-ink text-xl">✕</button>
			</div>
			<div id="friends-list" class="flex-grow overflow-y-auto p-4 space-y-2">
				<p class="text-sm text-steel text-center py-8">No friends yet. Add people you connect with!</p>
			</div>
		</div>

		<!-- History Panel (Side Drawer) -->
		<div id="history-panel" class="hidden fixed inset-y-0 right-0 w-full sm:w-80 bg-canvas border-l border-hairline shadow-2xl z-50 flex flex-col">
			<div class="p-4 border-b border-hairline flex items-center justify-between">
				<h3 class="font-bold text-ink">Call History</h3>
				<button onclick="document.getElementById('history-panel').classList.add('hidden')" class="text-slate hover:text-ink text-xl">✕</button>
			</div>
			<div id="history-list" class="flex-grow overflow-y-auto p-4 space-y-2">
				<p class="text-sm text-steel text-center py-8">No call history yet.</p>
			</div>
		</div>

		<!-- SCREENS CONTAINER -->
		<div class="flex-grow flex items-center justify-center p-0 sm:p-3 md:p-8">

			<!-- SCREEN 1: SETUP -->
			<div id="setup-screen" class="w-full max-w-[480px] bg-canvas border border-hairline rounded-2xl p-5 sm:p-6 md:p-8 shadow-2xl space-y-5 relative overflow-hidden">
				<!-- Decorative gradient blob -->
				<div class="absolute -top-20 -right-20 w-48 h-48 bg-primary/10 rounded-full blur-3xl pointer-events-none"></div>

				<!-- Your anonymous identity -->
				<div class="relative flex items-center space-x-3 bg-gradient-to-r from-primary/5 to-accent/5 border border-primary/10 rounded-xl p-3">
					<div id="my-avatar" class="w-11 h-11 bg-primary/15 text-primary flex items-center justify-center rounded-full text-xl shadow-sm">🦊</div>
					<div>
						<p class="font-bold text-sm text-ink" id="my-handle">CoolFox429</p>
						<p class="text-[10px] text-steel">Your anonymous identity</p>
					</div>
					<button onclick="generateHandle()" class="ml-auto text-xs text-primary font-semibold hover:underline bg-primary/10 px-2.5 py-1 rounded-full">↻</button>
				</div>

				<div class="text-center relative">
					<h1 class="text-xl sm:text-2xl font-extrabold text-ink">Talk to Strangers</h1>
					<p class="text-xs text-steel mt-1">Voice-only random chat — no camera, no signup</p>
				</div>

				<!-- Chat Mode - THE MAIN CHOICE -->
				<div class="grid grid-cols-3 gap-2 relative">
					<button id="mode-voice" class="bg-primary text-on-primary border-2 border-primary rounded-xl p-3 text-center font-bold text-sm transition-all shadow-md" onclick="setChatMode('voice')">
						🎙️ Voice
					</button>
					<button id="mode-text" class="bg-surface text-ink border-2 border-hairline rounded-xl p-3 text-center font-bold text-sm transition-all hover:border-primary" onclick="setChatMode('text')">
						💬 Text
					</button>
					<button id="mode-group" class="bg-surface text-ink border-2 border-hairline rounded-xl p-3 text-center font-bold text-sm transition-all hover:border-accent" onclick="setChatMode('group')">
						👥 Group
					</button>
				</div>

				<!-- Mood - simple one-line -->
				<div class="flex flex-wrap gap-1.5 justify-center relative">
					<button class="mood-btn bg-surface border border-hairline rounded-full px-2.5 py-1 text-[11px] font-medium transition-all hover:bg-primary-light hover:text-primary" onclick="setMood('happy')">😊</button>
					<button class="mood-btn bg-surface border border-hairline rounded-full px-2.5 py-1 text-[11px] font-medium transition-all hover:bg-primary-light hover:text-primary" onclick="setMood('chill')">😎</button>
					<button class="mood-btn bg-surface border border-hairline rounded-full px-2.5 py-1 text-[11px] font-medium transition-all hover:bg-primary-light hover:text-primary" onclick="setMood('bored')">😴</button>
					<button class="mood-btn bg-surface border border-hairline rounded-full px-2.5 py-1 text-[11px] font-medium transition-all hover:bg-primary-light hover:text-primary" onclick="setMood('deep')">🧠</button>
					<button class="mood-btn bg-surface border border-hairline rounded-full px-2.5 py-1 text-[11px] font-medium transition-all hover:bg-primary-light hover:text-primary" onclick="setMood('fun')">🎉</button>
					<span class="text-[10px] text-steel self-center ml-1">mood</span>
				</div>

				<!-- Expandable Options -->
				<details class="relative">
					<summary class="text-xs text-primary font-semibold cursor-pointer text-center">⚙️ More options (filters, modes, profile)</summary>
					<div class="space-y-4 pt-3">
						<!-- Profile -->
						<div class="grid grid-cols-3 gap-2">
							<input type="text" id="user-name" placeholder="Name" maxlength="20" class="w-full bg-surface text-ink text-xs rounded-lg border border-hairline px-2 h-9 focus:ring-2 focus:ring-primary focus:outline-none placeholder:text-stone" />
							<input type="number" id="user-age" placeholder="Age" min="13" max="99" class="w-full bg-surface text-ink text-xs rounded-lg border border-hairline px-2 h-9 focus:ring-2 focus:ring-primary focus:outline-none placeholder:text-stone" />
							<select id="user-gender" class="w-full bg-surface text-ink text-xs rounded-lg border border-hairline p-1.5 h-9 focus:ring-2 focus:ring-primary focus:outline-none">
								<option value="Male">♂ Male</option>
								<option value="Female">♀ Female</option>
								<option value="Other">⚧ Other</option>
							</select>
						</div>

						<!-- Status -->
						<input type="text" id="user-status" placeholder="💭 Status: Looking for deep convos..." maxlength="50" class="w-full bg-surface text-ink text-xs rounded-lg border border-hairline px-3 h-9 focus:ring-2 focus:ring-primary focus:outline-none placeholder:text-stone" />

						<!-- Special Modes -->
						<div class="flex flex-wrap gap-1.5">
							<button id="mode-mystery" class="special-mode-btn bg-surface border border-hairline rounded-lg px-2.5 py-1.5 text-[11px] font-semibold transition-all hover:bg-purple-50 hover:border-purple-300" onclick="toggleSpecialMode('mystery')">🎭 Mystery</button>
							<button id="mode-speed" class="special-mode-btn bg-surface border border-hairline rounded-lg px-2.5 py-1.5 text-[11px] font-semibold transition-all hover:bg-pink-50 hover:border-pink-300" onclick="toggleSpecialMode('speed')">⚡ Speed</button>
							<button id="mode-night" class="special-mode-btn bg-surface border border-hairline rounded-lg px-2.5 py-1.5 text-[11px] font-semibold transition-all hover:bg-indigo-50 hover:border-indigo-300" onclick="toggleSpecialMode('night')">🌙 Night</button>
						</div>

						<!-- Filters -->
						<div class="grid grid-cols-2 gap-2">
							<div class="relative">
								<input type="text" id="language-search" placeholder="Language..." class="w-full bg-surface text-ink text-xs rounded-lg border border-hairline px-2 h-9 focus:ring-2 focus:ring-primary focus:outline-none" autocomplete="off" />
								<input type="hidden" id="language-filter" value="English" />
								<div id="language-dropdown" class="hidden absolute z-20 w-full mt-1 bg-canvas border border-hairline rounded-lg shadow-lg max-h-40 overflow-y-auto"></div>
							</div>
							<div class="relative">
								<input type="text" id="country-search" placeholder="Country..." class="w-full bg-surface text-ink text-xs rounded-lg border border-hairline px-2 h-9 focus:ring-2 focus:ring-primary focus:outline-none" autocomplete="off" />
								<input type="hidden" id="country-filter" value="Worldwide" />
								<div id="country-dropdown" class="hidden absolute z-20 w-full mt-1 bg-canvas border border-hairline rounded-lg shadow-lg max-h-40 overflow-y-auto"></div>
							</div>
						</div>

						<!-- Interests -->
						<div>
							<input type="text" id="interest-input" placeholder="Interests: gaming, music..." class="w-full bg-surface text-ink text-xs rounded-lg border border-hairline px-2 h-9 focus:ring-2 focus:ring-primary focus:outline-none" />
							<div class="flex flex-wrap gap-1 pt-1.5">
								<button class="bg-primary-light text-primary text-[10px] px-2 py-0.5 rounded-full hover:bg-primary hover:text-on-primary transition-colors" onclick="addTag('Gaming')">Gaming</button>
								<button class="bg-primary-light text-primary text-[10px] px-2 py-0.5 rounded-full hover:bg-primary hover:text-on-primary transition-colors" onclick="addTag('Music')">Music</button>
								<button class="bg-primary-light text-primary text-[10px] px-2 py-0.5 rounded-full hover:bg-primary hover:text-on-primary transition-colors" onclick="addTag('Anime')">Anime</button>
								<button class="bg-primary-light text-primary text-[10px] px-2 py-0.5 rounded-full hover:bg-primary hover:text-on-primary transition-colors" onclick="addTag('Movies')">Movies</button>
								<button class="bg-primary-light text-primary text-[10px] px-2 py-0.5 rounded-full hover:bg-primary hover:text-on-primary transition-colors" onclick="addTag('Tech')">Tech</button>
							</div>
						</div>
					</div>
				</details>

				<!-- START BUTTON -->
				<button id="start-match-btn" class="w-full bg-gradient-to-r from-primary to-primary-deep hover:from-primary-deep hover:to-primary text-on-primary font-bold text-base py-4 rounded-xl transition-all shadow-lg hover:shadow-xl relative overflow-hidden group">
					<span class="relative z-10 flex items-center justify-center space-x-2">
						<svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
						<span>Start Matching</span>
					</span>
					<div class="absolute inset-0 bg-white/10 translate-x-[-100%] group-hover:translate-x-[100%] transition-transform duration-700 skew-x-12"></div>
				</button>

				<!-- Bottom links -->
				<div class="flex items-center justify-between text-[11px]">
					<button onclick="shareInvite()" class="text-primary font-semibold hover:underline flex items-center space-x-1">
						<svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"/></svg>
						<span>Invite</span>
					</button>
					<span class="text-steel">Free forever</span>
					<button onclick="showAchievements()" class="text-accent font-semibold hover:underline flex items-center space-x-1">
						<svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"/></svg>
						<span>Badges</span>
					</button>
				</div>
			</div>

			<!-- SCREEN 2: SEARCHING -->
			<div id="matching-screen" class="hidden w-full max-w-[460px] bg-canvas border border-hairline rounded-xl p-8 shadow-lg flex flex-col items-center text-center space-y-8 min-h-[380px]">
				<div class="space-y-2">
					<h2 class="text-2xl font-bold text-ink">Finding someone...</h2>
					<p class="text-sm text-slate" id="search-mode-label">Voice Chat</p>
				</div>
				<div class="relative w-32 h-32 flex items-center justify-center">
					<div class="absolute inset-0 bg-primary/10 rounded-full animate-radar"></div>
					<div class="absolute inset-4 bg-primary/20 rounded-full animate-radar" style="animation-delay:0.6s"></div>
					<div class="relative w-14 h-14 bg-primary rounded-full flex items-center justify-center text-on-primary text-xl shadow-lg animate-pulse" id="search-icon">🎙️</div>
				</div>
				<div id="search-details" class="bg-surface rounded-lg border border-hairline p-3 w-full text-xs text-slate text-left"></div>
				<button id="cancel-match-btn" class="bg-surface border border-hairline hover:bg-cream text-ink text-sm font-semibold py-2.5 px-6 rounded-lg transition-colors flex items-center space-x-1.5">
					<svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
					<span>Cancel</span>
				</button>
			</div>

			<!-- SCREEN 3: ACTIVE CALL/CHAT -->
			<div id="call-screen" class="hidden w-full max-w-[1000px] bg-canvas border border-hairline rounded-none sm:rounded-2xl shadow-2xl overflow-hidden flex flex-col md:grid md:grid-cols-12 h-[calc(100vh-4rem)] sm:h-[calc(100vh-5rem)] md:h-[600px] md:max-h-none md:min-h-[540px]">

				<!-- Left Panel: Voice/Info -->
				<div class="md:col-span-7 p-3 sm:p-4 md:p-5 flex flex-col justify-between md:border-r border-hairline bg-gradient-to-b from-surface/80 to-canvas overflow-y-auto max-h-[35%] md:max-h-none flex-shrink-0 md:flex-shrink">
					<div class="space-y-4">
						<!-- Status Bar -->
						<div class="flex items-center justify-between">
							<span class="inline-flex items-center space-x-1.5 bg-accent/10 border border-accent/20 text-accent px-3 py-1 rounded-full text-xs font-semibold">
								<span class="w-2 h-2 bg-accent rounded-full animate-ping"></span>
								<span id="call-status-label">Live Call</span>
							</span>
							<span id="call-timer" class="text-sm font-mono text-slate font-semibold">00:00</span>
						</div>

						<!-- Partner Info Card -->
						<div class="bg-canvas border border-hairline rounded-xl p-4 flex items-center space-x-4 shadow-sm hover:shadow-md transition-shadow">
							<div id="partner-avatar" class="w-11 h-11 bg-primary/10 text-primary flex items-center justify-center rounded-full text-lg font-bold">🐻</div>
							<div class="space-y-1 flex-grow">
								<div class="flex items-center justify-between">
									<h4 id="partner-handle" class="font-bold text-base text-ink">Stranger</h4>
									<span id="partner-country" class="text-xs bg-surface text-slate px-2 py-0.5 rounded-full">🌍 --</span>
								</div>
								<div class="flex items-center space-x-2 text-xs text-steel">
									<span id="partner-lang">--</span>
								</div>
								<div id="partner-tags" class="flex flex-wrap gap-1 pt-1"></div>
							</div>
						</div>
					</div>

					<!-- Equalizer (Voice mode only) -->
					<div id="eq-section" class="hidden sm:flex my-6 items-center justify-center h-24 space-x-1">
						<div class="w-1.5 h-12 bg-primary rounded-full animate-pulse eq-bar"></div>
						<div class="w-1.5 h-18 bg-primary/70 rounded-full animate-pulse-slow eq-bar"></div>
						<div class="w-1.5 h-22 bg-primary rounded-full animate-pulse eq-bar"></div>
						<div class="w-1.5 h-14 bg-primary/50 rounded-full animate-pulse-slow eq-bar"></div>
						<div class="w-1.5 h-8 bg-primary rounded-full animate-pulse eq-bar"></div>
						<div class="w-1.5 h-16 bg-primary/70 rounded-full animate-pulse-slow eq-bar"></div>
						<div class="w-1.5 h-20 bg-primary rounded-full animate-pulse eq-bar"></div>
						<div class="w-1.5 h-10 bg-primary/50 rounded-full animate-pulse eq-bar"></div>
					</div>

					<!-- Text-only mode message -->
					<div id="text-mode-info" class="hidden my-6 text-center text-sm text-slate py-8">
						<p class="text-3xl mb-2">💬</p>
						<p>Text-only mode — use the chat panel →</p>
					</div>

					<!-- Controls -->
					<div class="flex flex-wrap items-center justify-center md:justify-between gap-2 pt-4 border-t border-hairline">
						<div class="flex items-center space-x-2">
							<button id="mute-btn" class="bg-canvas border border-hairline hover:bg-cream text-ink p-2.5 rounded-lg text-sm font-medium transition-colors flex items-center justify-center" title="Mute Microphone">
								<svg id="mute-icon-on" class="w-5 h-5 text-ink" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"/>
									<path stroke-linecap="round" stroke-linejoin="round" d="M19 10v1a7 7 0 0 1-14 0v-1M12 19v4m-4 0h8"/>
								</svg>
								<svg id="mute-icon-off" class="w-5 h-5 text-red-500 hidden" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 5.07 2.12M12 19v4m-4 0h8M3 3l18 18M9 9v3a3 3 0 0 0 .37 1.45M19 10v1a6.93 6.93 0 0 1-.94 3.47m-2.15-2.15A4 4 0 0 0 15 12"/>
								</svg>
							</button>
							<button id="voice-fx-btn" class="bg-canvas border border-hairline hover:bg-cream text-ink p-2.5 rounded-lg text-sm font-medium transition-colors flex items-center justify-center" title="Voice Effects">
								<svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
