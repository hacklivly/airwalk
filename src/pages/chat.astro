// IMAGE SHARING
// ==========================================
document.getElementById('image-btn').addEventListener('click', () => document.getElementById('image-input').click());
document.getElementById('image-input').addEventListener('change', function(e) {
	const file = e.target.files[0];
	if (!file) return;
	if (file.size > 5 * 1024 * 1024) { alert('Max 5MB'); return; }
	const reader = new FileReader();
	reader.onload = function(ev) {
		const imgHtml = `<img src="${ev.target.result}" class="max-w-[200px] rounded-lg border border-hairline" alt="Shared image"/>`;
		addMyChatMsg(imgHtml, true);
		if (ws?.readyState === WebSocket.OPEN && matchedPeerId) {
			ws.send(JSON.stringify({ type: 'chat_message', data: { targetPeerId: matchedPeerId, text: `[IMG]${ev.target.result}[/IMG]` } }));
		}
	};
	reader.readAsDataURL(file);
	this.value = '';
});

// ==========================================
// CORE SIGNALING
// ==========================================
async function initAudio() {
	if (chatMode === 'text') return true;
	try { if (localStream) return true; localStream = await navigator.mediaDevices.getUserMedia({ audio: true }); return true; }
	catch(e) { showAlert('Microphone required for voice chat.'); return false; }
}

function showAlert(msg) { document.getElementById('alert-message').textContent = msg; document.getElementById('alert-banner').classList.remove('hidden'); }

document.getElementById('start-match-btn').addEventListener('click', async () => {
	const ok = await initAudio();
	if (!ok) return;
	setupScreen.classList.add('hidden');
	matchingScreen.classList.remove('hidden');
	document.getElementById('search-mode-label').textContent = chatMode === 'voice' ? 'Voice Chat' : 'Text Only';
	document.getElementById('search-icon').textContent = chatMode === 'voice' ? '🎙️' : '💬';
	const lang = document.getElementById('language-filter').value;
	const country = document.getElementById('country-filter').value;
	const tags = document.getElementById('interest-input').value;
	document.getElementById('search-details').innerHTML = `<strong>Filters:</strong> ${lang} • ${country}${tags ? ' • ' + tags : ''}`;
	connectWS();
});

document.getElementById('cancel-match-btn').addEventListener('click', () => {
	if (ws?.readyState === WebSocket.OPEN) ws.close();
	cleanup();
	matchingScreen.classList.add('hidden');
	setupScreen.classList.remove('hidden');
});

function connectWS() {
	if (ws?.readyState === WebSocket.OPEN) {
		if (window.reconnectTarget) {
			sendReconnect(window.reconnectTarget);
			window.reconnectTarget = null;
		} else {
			sendJoin();
		}
		return;
	}
	if (ws?.readyState === WebSocket.CONNECTING) return;
	// Production: connect to Cloudflare Worker signaling server
	// Local dev: connect to localhost:3001
	const isLocal = location.hostname === 'localhost' || location.hostname === '127.0.0.1';
	const wsUrl = isLocal
		? `ws://${location.hostname}:3001`
		: 'wss://airwalk-signal.airwalkhq.workers.dev';
	ws = new WebSocket(wsUrl);
	ws.onopen = () => {
		document.getElementById('online-indicator').textContent = '🟢 Online';
		if (window.reconnectTarget) {
			sendReconnect(window.reconnectTarget);
			window.reconnectTarget = null;
		} else {
			sendJoin();
		}
	};
	ws.onmessage = async (e) => {
		const msg = JSON.parse(e.data);
		switch(msg.type) {
			case 'matched': onMatched(msg.data); break;
			case 'offer': await onOffer(msg.data); break;
			case 'answer': if(pc) await pc.setRemoteDescription(new RTCSessionDescription(msg.data)); break;
			case 'candidate': if(pc) await pc.addIceCandidate(new RTCIceCandidate(msg.data)); break;
			case 'chat_message': onRemoteMsg(msg.data.text); break;
			case 'typing': msg.data.isTyping ? document.getElementById('typing-indicator').classList.remove('hidden') : document.getElementById('typing-indicator').classList.add('hidden'); break;
			case 'game_action': onGameAction(msg.data); break;
			case 'mute_status': showMuteIndicator(msg.data.isMuted); break;
			case 'skipped': addSystemMsg('Partner skipped.'); reMatch(); break;
			case 'disconnected': addSystemMsg('Partner left. Finding new match...'); reMatch(); break;
			case 'reconnected': clearReconnectTimer(); addSystemMsg('Partner reconnected!'); break;
			case 'incoming_call': showIncomingCall(msg.data); break;
			case 'call_rejected': onCallRejected(msg.data); break;
		}
	};
	ws.onclose = () => {
		document.getElementById('online-indicator').textContent = '🔴 Offline';
		// Auto-reconnect if we were matching
		if (!matchingScreen.classList.contains('hidden')) {
			setTimeout(() => connectWS(), 2000);
		}
	};
}

function sendJoin() {
	const lang = document.getElementById('language-filter').value;
	const country = document.getElementById('country-filter').value;
	const tags = document.getElementById('interest-input').value.split(',').map(t=>t.trim()).filter(Boolean);
	const handle = localStorage.getItem('airwalk_handle');
	const avatar = localStorage.getItem('airwalk_avatar');
	const name = document.getElementById('user-name').value.trim() || handle;
	const age = parseInt(document.getElementById('user-age').value) || 18;
	const gender = document.getElementById('user-gender').value;
	const status = document.getElementById('user-status')?.value?.trim() || '';
	localStorage.setItem('airwalk_name', name);
	localStorage.setItem('airwalk_age', age);
	localStorage.setItem('airwalk_gender', gender);
	localStorage.setItem('airwalk_language', lang);
	localStorage.setItem('airwalk_country', country);
	localStorage.setItem('airwalk_interests', document.getElementById('interest-input').value);
	ws.send(JSON.stringify({ type: 'join', data: { id: myClientId, language: lang, country, tags, handle, avatar, chatMode, name, age, gender, status } }));
}

function onMatched(data) {
	// Check if this person is blocked
	const blocked = JSON.parse(localStorage.getItem('airwalk_blocked')||'[]');
	const pi = data.peerInfo;
	if(blocked.includes(data.peerId) || blocked.includes(pi.handle) || blocked.includes(pi.name)) {
		// Auto-skip blocked user
		if(ws?.readyState===1) ws.send(JSON.stringify({type:'skip'}));
		return;
	}

	matchedPeerId = data.peerId;
	activeRole = data.role;
	isBotCall = !!data.isBot;

	document.getElementById('partner-handle').textContent = pi.name || pi.handle || 'Stranger';
	document.getElementById('partner-avatar').textContent = pi.avatar || '🐻';
	document.getElementById('partner-country').textContent = `🌍 ${pi.country}`;
	const genderIcon = pi.gender === 'Female' ? '♀' : pi.gender === 'Male' ? '♂' : '⚧';
	document.getElementById('partner-lang').textContent = `${genderIcon} ${pi.gender || '--'} • ${pi.age || '--'}yo • ${pi.language}`;
	document.getElementById('partner-tags').innerHTML = (pi.tags||[]).map(t => `<span class="text-[10px] bg-primary/10 text-primary px-2 py-0.5 rounded-full">#${t}</span>`).join('');

	// Show/hide voice UI
	if (chatMode === 'voice') {
		document.getElementById('eq-section').classList.remove('hidden');
		document.getElementById('text-mode-info').classList.add('hidden');
		document.getElementById('mute-btn').classList.remove('hidden');
		document.getElementById('call-status-label').textContent = 'Live Call';
	} else {
		document.getElementById('eq-section').classList.add('hidden');
		document.getElementById('text-mode-info').classList.remove('hidden');
		document.getElementById('mute-btn').classList.add('hidden');
		document.getElementById('call-status-label').textContent = 'Text Chat';
	}

	chatMessages.innerHTML = '<div class="text-center text-xs text-slate italic bg-surface py-1.5 px-3 rounded-lg">Connected! Say hello 👋</div>';
	switchTab('chat');
	exitGame();
	matchingScreen.classList.add('hidden');
	callScreen.classList.remove('hidden');
	startTimer();
	startSkipCooldown();
	if (chatMode === 'voice') startEq();
	if (isBotCall) startBot();
	else if (chatMode === 'voice') startWebRTC();
}

// WebRTC
async function startWebRTC() {
	pc = new RTCPeerConnection(iceConfig);
	pc.onicecandidate = e => { if(e.candidate && ws?.readyState===1) ws.send(JSON.stringify({type:'candidate',targetPeerId:matchedPeerId,data:e.candidate})); };
	pc.ontrack = e => { document.getElementById('remote-audio').srcObject = e.streams[0]; };
	if(localStream) localStream.getTracks().forEach(t => pc.addTrack(t, localStream));
	if(activeRole==='initiator') { const o = await pc.createOffer(); await pc.setLocalDescription(o); ws.send(JSON.stringify({type:'offer',targetPeerId:matchedPeerId,data:o})); }
}
async function onOffer(offer) {
	if(isBotCall) return;
	pc = new RTCPeerConnection(iceConfig);
	pc.onicecandidate = e => { if(e.candidate && ws?.readyState===1) ws.send(JSON.stringify({type:'candidate',targetPeerId:matchedPeerId,data:e.candidate})); };
	pc.ontrack = e => { document.getElementById('remote-audio').srcObject = e.streams[0]; };
	if(localStream) localStream.getTracks().forEach(t => pc.addTrack(t, localStream));
	await pc.setRemoteDescription(new RTCSessionDescription(offer));
	const a = await pc.createAnswer(); await pc.setLocalDescription(a);
	ws.send(JSON.stringify({type:'answer',targetPeerId:matchedPeerId,data:a}));
}

// Timer & EQ
let callStart = 0;
function startTimer() { callStart = Date.now(); callTimerInterval = setInterval(() => { const s=Math.floor((Date.now()-callStart)/1000); document.getElementById('call-timer').textContent=`${String(Math.floor(s/60)).padStart(2,'0')}:${String(s%60).padStart(2,'0')}`; }, 1000); }
function stopTimer() { if(callTimerInterval){clearInterval(callTimerInterval);callTimerInterval=null;} document.getElementById('call-timer').textContent='00:00'; }
let eqInt = null;
function startEq() { eqInt = setInterval(()=>{eqBars.forEach(b=>{b.style.height=`${Math.random()*80+10}px`;});},150); }
function stopEq() { if(eqInt){clearInterval(eqInt);eqInt=null;} eqBars.forEach(b=>{b.style.height='12px';}); }
function startSkipCooldown() {
	const btn = document.getElementById('skip-btn'); const lbl = document.getElementById('skip-btn-label');
	btn.disabled=true; let c=5; lbl.textContent=`${c}s`;
	skipInterval = setInterval(()=>{ c--; if(c>0) lbl.textContent=`${c}s`; else{clearInterval(skipInterval);btn.disabled=false;lbl.textContent='';} },1000);
}

function getCallDuration() { return document.getElementById('call-timer').textContent; }
function cleanup() {
	stopTimer();
	stopEq();
	if(pc){pc.close();pc=null;}
	document.getElementById('remote-audio').srcObject=null;
	if(botTimeout)clearTimeout(botTimeout);
	matchedPeerId=null;
	activeRole=null;
	isBotCall=false;
	botSeq=0;
	exitGame();
	
	isMuted = false;
	const muteOn = document.getElementById('mute-icon-on');
	const muteOff = document.getElementById('mute-icon-off');
	if (muteOn && muteOff) {
		muteOn.classList.remove('hidden');
		muteOff.classList.add('hidden');
	}
}
function reMatch() { const dur = getCallDuration(); if(dur!=='00:00') saveHistory(dur); cleanup(); callScreen.classList.add('hidden'); matchingScreen.classList.remove('hidden'); connectWS(); }

let lastPartnerHandle = null;
let lastPartnerAvatar = null;

function onPartnerDisconnected() {
	// Save last partner info for recall
	lastPartnerHandle = document.getElementById('partner-handle').textContent;
	lastPartnerAvatar = document.getElementById('partner-avatar').textContent;
	const dur = getCallDuration();
	if(dur!=='00:00') saveHistory(dur);
	cleanup();
	callScreen.classList.add('hidden');
	matchingScreen.classList.remove('hidden');

	// Show recall UI in matching screen
	document.getElementById('search-mode-label').textContent = 'Partner disconnected';
	document.getElementById('search-icon').textContent = '😢';
	document.getElementById('search-details').innerHTML = `
		<div class="flex items-center justify-between">
			<span class="text-ink font-medium">${lastPartnerAvatar} ${lastPartnerHandle} left</span>
			<button id="recall-btn" class="bg-primary text-on-primary text-xs font-bold px-3 py-1.5 rounded-lg flex items-center space-x-1" onclick="recallLast()">
				<svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 10h4l3-7 4 14 3-7h4"/></svg>
				<span>Recall</span>
			</button>
		</div>
		<p class="text-[10px] text-steel mt-1">Finding new match in 10s or tap Recall to reconnect...</p>
	`;

	// Auto-find new match after 10s unless user taps recall
	window._autoMatchTimer = setTimeout(() => {
		connectWS();
	}, 10000);
}

window.recallLast = function() {
	if(window._autoMatchTimer) { clearTimeout(window._autoMatchTimer); window._autoMatchTimer = null; }
	if(lastPartnerHandle) {
		reconnectTo(lastPartnerHandle);
	}
};

// ==========================================
// INCOMING CALL UI
// ==========================================
let incomingCallTimeout = null;

function showIncomingCall(data) {
	const { callerId, callerName, callerAvatar } = data;
	// Remove any existing call modal
	const existing = document.getElementById('incoming-call-modal');
	if(existing) existing.remove();

	const modal = document.createElement('div');
	modal.id = 'incoming-call-modal';
	modal.className = 'fixed inset-0 z-[100] flex items-center justify-center bg-black/60 backdrop-blur-sm';
	modal.innerHTML = `
		<div class="bg-canvas rounded-2xl p-6 w-[300px] text-center space-y-4 shadow-2xl border border-hairline animate-pulse">
			<div class="w-16 h-16 mx-auto bg-primary/15 rounded-full flex items-center justify-center text-3xl">${callerAvatar || '📞'}</div>
			<div>
				<p class="font-bold text-lg text-ink">${callerName}</p>
				<p class="text-sm text-steel">is calling you...</p>
			</div>
			<div class="flex justify-center gap-4 pt-2">
				<button onclick="rejectIncomingCall('${callerId}')" class="w-14 h-14 rounded-full bg-red-500 hover:bg-red-600 text-white flex items-center justify-center shadow-lg transition-colors">
					<svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
				</button>
				<button onclick="acceptIncomingCall('${callerId}')" class="w-14 h-14 rounded-full bg-green-500 hover:bg-green-600 text-white flex items-center justify-center shadow-lg transition-colors animate-bounce">
					<svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
				</button>
			</div>
		</div>
	`;
	document.body.appendChild(modal);

	// Play ringtone
	if(typeof playTone==='function') {
		let ring = 0;
		incomingCallTimeout = setInterval(() => {
			playTone(600, 0.15); setTimeout(()=>playTone(800, 0.15), 200);
			ring++;
			if(ring > 15) { clearInterval(incomingCallTimeout); rejectIncomingCall(callerId); }
		}, 1500);
	}
}

window.acceptIncomingCall = function(callerId) {
	if(incomingCallTimeout) { clearInterval(incomingCallTimeout); incomingCallTimeout = null; }
	const modal = document.getElementById('incoming-call-modal');
	if(modal) modal.remove();

	if(ws?.readyState === WebSocket.OPEN) {
		ws.send(JSON.stringify({ type: 'accept_call', data: { callerId } }));
	}
};

window.rejectIncomingCall = function(callerId) {
	if(incomingCallTimeout) { clearInterval(incomingCallTimeout); incomingCallTimeout = null; }
	const modal = document.getElementById('incoming-call-modal');
	if(modal) modal.remove();

	if(ws?.readyState === WebSocket.OPEN) {
		ws.send(JSON.stringify({ type: 'reject_call', data: { callerId } }));
	}
};

function onCallRejected(data) {
	addSystemMsg(data.reason === 'offline' ? `${data.targetHandle} is offline.` : 'Call declined. Finding new match...');
	// Start normal matching
	if(ws?.readyState === WebSocket.OPEN) sendJoin();
}

window.stopConnecting = function() {
	if (ws?.readyState === WebSocket.OPEN) {
		ws.send(JSON.stringify({ type: 'skip' }));
		ws.close();
		ws = null;
	}
	cleanup();
	callScreen.classList.add('hidden');
	matchingScreen.classList.add('hidden');
	setupScreen.classList.remove('hidden');
};

// Controls
document.getElementById('skip-btn').addEventListener('click', () => { if(ws?.readyState===1) ws.send(JSON.stringify({type:'skip'})); addSystemMsg('Skipped. Searching...'); reMatch(); });
document.getElementById('mute-btn').addEventListener('click', () => {
	if(!localStream) return; isMuted=!isMuted;
	localStream.getAudioTracks().forEach(t=>{t.enabled=!isMuted;});
	
	const muteOn = document.getElementById('mute-icon-on');
	const muteOff = document.getElementById('mute-icon-off');
	if (isMuted) {
		muteOn.classList.add('hidden');
		muteOff.classList.remove('hidden');
	} else {
		muteOn.classList.remove('hidden');
		muteOff.classList.add('hidden');
	}

	// Notify partner about mute status
	if(ws?.readyState===1&&matchedPeerId) ws.send(JSON.stringify({type:'mute_status',data:{targetPeerId:matchedPeerId,isMuted}}));
});
document.getElementById('volume-slider').addEventListener('input', e => { document.getElementById('remote-audio').volume = e.target.value; });
document.getElementById('report-btn').addEventListener('click', () => {
	if(!matchedPeerId) return;
	if(confirm('Report this user for abuse? They will be blocked.')) {
		const blocked = JSON.parse(localStorage.getItem('airwalk_blocked')||'[]');
		const handle = document.getElementById('partner-handle').textContent;
		if(!blocked.includes(matchedPeerId)) blocked.push(matchedPeerId);
		if(!blocked.includes(handle)) blocked.push(handle);
		localStorage.setItem('airwalk_blocked', JSON.stringify(blocked));
		if(ws?.readyState===1) ws.send(JSON.stringify({type:'report',data:{targetPeerId:matchedPeerId}}));
		addSystemMsg('⚠️ User reported and blocked.');
		reMatch();
	}
});
document.getElementById('block-btn').addEventListener('click', () => {
	if(!matchedPeerId) return;
	if(confirm('Block this user? You won\'t be matched with them again.')) {
		const blocked = JSON.parse(localStorage.getItem('airwalk_blocked')||'[]');
		const handle = document.getElementById('partner-handle').textContent;
		if(!blocked.includes(matchedPeerId)) blocked.push(matchedPeerId);
		if(!blocked.includes(handle)) blocked.push(handle);
		localStorage.setItem('airwalk_blocked', JSON.stringify(blocked));
		if(ws?.readyState===1) ws.send(JSON.stringify({type:'skip'}));
		addSystemMsg('🚫 User blocked.');
		reMatch();
	}
});

// ==========================================
// MUTE INDICATOR
// ==========================================
function showMuteIndicator(partnerMuted) {
	let ind = document.getElementById('partner-mute-indicator');
	if(!ind) {
		ind = document.createElement('div');
		ind.id = 'partner-mute-indicator';
		ind.className = 'text-center text-xs font-semibold py-1.5 px-3 rounded-lg mt-2';
		document.getElementById('partner-avatar').parentElement.parentElement.appendChild(ind);
	}
	if(partnerMuted) {
		ind.className = 'text-center text-xs font-semibold py-1.5 px-3 rounded-lg mt-2 bg-red-50 text-red-500 border border-red-200';
		ind.textContent = '🔇 Partner is muted';
		ind.classList.remove('hidden');
	} else {
		ind.className = 'text-center text-xs font-semibold py-1.5 px-3 rounded-lg mt-2 bg-accent/10 text-accent border border-accent/20';
		ind.textContent = '🎙️ Partner unmuted';
		setTimeout(() => ind.classList.add('hidden'), 2000);
	}
}

// ==========================================
// 60s RECONNECT TIMER
// ==========================================
let reconnectTimeout = null;
let reconnectCountdown = null;

function startReconnectTimer() {
	addSystemMsg('⏳ Partner disconnected. Waiting 60s for reconnection...');
	let sec = 60;
	const lbl = document.getElementById('call-status-label');
	lbl.textContent = `Reconnecting (${sec}s)`;
	reconnectCountdown = setInterval(() => {
		sec--;
		lbl.textContent = `Reconnecting (${sec}s)`;
		if(sec <= 0) { clearInterval(reconnectCountdown); }
	}, 1000);
	reconnectTimeout = setTimeout(() => {
		clearInterval(reconnectCountdown);
		addSystemMsg('Partner did not reconnect. Finding new match...');
		reMatch();
	}, 60000);
}

function clearReconnectTimer() {
	if(reconnectTimeout) { clearTimeout(reconnectTimeout); reconnectTimeout=null; }
	if(reconnectCountdown) { clearInterval(reconnectCountdown); reconnectCountdown=null; }
	document.getElementById('call-status-label').textContent = chatMode==='voice' ? 'Live Call' : 'Text Chat';
}

// ==========================================
// CHAT MESSAGES
// ==========================================
function sendChat() {
	const text = chatInput.value.trim(); if(!text) return;
	addMyChatMsg(escapeHTML(text));
	chatInput.value = '';
	if(isBotCall) { if(botTimeout)clearTimeout(botTimeout); botReply(1500); }
	else if(ws?.readyState===1&&matchedPeerId) ws.send(JSON.stringify({type:'chat_message',data:{targetPeerId:matchedPeerId,text}}));
}
document.getElementById('send-btn').addEventListener('click', sendChat);
chatInput.addEventListener('keydown', e => { if(e.key==='Enter') sendChat(); });
chatInput.addEventListener('input', () => {
	if(!matchedPeerId||isBotCall) return;
	if(ws?.readyState===1) ws.send(JSON.stringify({type:'typing',data:{targetPeerId:matchedPeerId,isTyping:true}}));
	if(typingTimer) clearTimeout(typingTimer);
	typingTimer = setTimeout(()=>{if(ws?.readyState===1&&matchedPeerId)ws.send(JSON.stringify({type:'typing',data:{targetPeerId:matchedPeerId,isTyping:false}}));},2000);
});

function onRemoteMsg(text) {
	if(text.startsWith('[REACT]')) {
		// Show reaction on last sent message
		const emoji = text.slice(7);
		const msgs = chatMessages.querySelectorAll('[id^="react-"]');
		if(msgs.length) msgs[msgs.length-1].textContent = emoji;
		return;
	}
	if(text.startsWith('[IMG]') && text.endsWith('[/IMG]')) {
		const src = text.slice(5, -6);
		const safeSrc = src.replace(/["]/g, '&quot;');
		addRemoteChatMsg(`<img src="${safeSrc}" class="max-w-[200px] rounded-lg border border-hairline" alt="Image"/>`, true);
	} else {
		addRemoteChatMsg(escapeHTML(text));
	}
}

let msgCounter = 0;
function addMyChatMsg(content, isHtml=false) {
	const t = (typeof chatThemes !== 'undefined') ? chatThemes[currentChatTheme] : {myBg:'bg-primary',myText:'text-on-primary'};
	const id = 'msg-' + (msgCounter++);
	const d = document.createElement('div'); d.className = 'flex flex-col items-end space-y-0.5';
	const time = new Date().toLocaleTimeString([],{hour:'2-digit',minute:'2-digit'});
	d.innerHTML = `<div class="relative max-w-[80%]"><div class="${t.myBg} ${t.myText} py-2.5 px-4 rounded-2xl rounded-br-md wrap-break-word text-[13px] leading-relaxed shadow-sm cursor-pointer inline-block" data-msgid="${id}">${content}</div><div id="react-${id}" class="absolute -bottom-3 left-0 text-sm"></div><div class="react-picker hidden absolute -top-8 left-0 flex bg-canvas border border-hairline rounded-full shadow-lg px-1 py-0.5 space-x-0.5 z-10">${['👍','❤️','😂','😮','😢'].map(e=>`<button class="hover:scale-125 transition-transform text-base px-0.5" onclick="react('${id}','${e}')">${e}</button>`).join('')}</div></div><span class="text-[10px] text-stone px-1">You · ${time}</span>`;
	d.querySelector(`[data-msgid="${id}"]`).addEventListener('dblclick', () => d.querySelector('.react-picker').classList.toggle('hidden'));
	chatMessages.appendChild(d); chatMessages.scrollTop = chatMessages.scrollHeight;
	if(typeof resetSilenceTimer==='function') resetSilenceTimer();
}
function addRemoteChatMsg(content, isHtml=false) {
	const t = (typeof chatThemes !== 'undefined') ? chatThemes[currentChatTheme] : {theirBg:'bg-surface border border-hairline',theirText:'text-ink'};
	const id = 'msg-' + (msgCounter++);
	const d = document.createElement('div'); d.className = 'flex flex-col items-start space-y-0.5';
	const time = new Date().toLocaleTimeString([],{hour:'2-digit',minute:'2-digit'});
	const handle = document.getElementById('partner-handle').textContent;
	d.innerHTML = `<div class="relative max-w-[80%]"><div class="${t.theirBg} ${t.theirText} py-2.5 px-4 rounded-2xl rounded-bl-md wrap-break-word text-[13px] leading-relaxed shadow-sm cursor-pointer inline-block" data-msgid="${id}">${content}</div><div id="react-${id}" class="absolute -bottom-3 right-0 text-sm"></div><div class="react-picker hidden absolute -top-8 right-0 flex bg-canvas border border-hairline rounded-full shadow-lg px-1 py-0.5 space-x-0.5 z-10">${['👍','❤️','😂','😮','😢'].map(e=>`<button class="hover:scale-125 transition-transform text-base px-0.5" onclick="react('${id}','${e}')">${e}</button>`).join('')}</div></div><span class="text-[10px] text-stone px-1">${handle} · ${time}</span>`;
	d.querySelector(`[data-msgid="${id}"]`).addEventListener('dblclick', () => d.querySelector('.react-picker').classList.toggle('hidden'));
	chatMessages.appendChild(d); chatMessages.scrollTop = chatMessages.scrollHeight;
	if(typeof soundMessage==='function') soundMessage();
	if(typeof resetSilenceTimer==='function') resetSilenceTimer();
}
window.react = function(msgId, emoji) {
	document.getElementById('react-'+msgId).textContent = emoji;
	document.querySelectorAll('.react-picker').forEach(p => p.classList.add('hidden'));
	if(ws?.readyState===1&&matchedPeerId) ws.send(JSON.stringify({type:'chat_message',data:{targetPeerId:matchedPeerId,text:`[REACT]${emoji}`}}));
};
function addSystemMsg(text) {
	const d = document.createElement('div'); d.className = 'text-center text-xs text-slate italic bg-surface py-1.5 px-3 rounded-lg';
	d.textContent = text; chatMessages.appendChild(d); chatMessages.scrollTop = chatMessages.scrollHeight;
}
function escapeHTML(s) { return s.replace(/[&<>'"]/g, c=>({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[c]||c)); }

// ==========================================
// BOT
// ==========================================
function startBot() { botSeq=0; botReply(2500); }
function botReply(delay) {
	botTimeout = setTimeout(()=>{
		document.getElementById('typing-indicator').classList.remove('hidden');
		botTimeout = setTimeout(()=>{
			document.getElementById('typing-indicator').classList.add('hidden');
			botSeq++;
			const msgs = ["Hey! How's it going? 👋","What brings you to Airwalk today?","I love that everything here is free — no coins needed!","Try out the games tab! We can play while chatting.","Feel free to skip when you want. It unlocks after 5 seconds."];
			addRemoteChatMsg(escapeHTML(msgs[Math.min(botSeq-1, msgs.length-1)]));
			if(botSeq<5) botReply(5000+Math.random()*3000);
		}, 1200);
	}, delay);
}

// ==========================================
// TABS
// ==========================================
window.switchTab = function(tab) {
	const tc = document.getElementById('tab-chat-btn'), tg = document.getElementById('tab-games-btn');
	if(tab==='chat') {
		tc.className="flex-1 text-center py-2.5 text-xs font-bold uppercase tracking-wider text-primary border-b-2 border-primary focus:outline-none flex items-center justify-center space-x-1";
		tg.className="flex-1 text-center py-2.5 text-xs font-bold uppercase tracking-wider text-slate hover:text-primary focus:outline-none relative flex items-center justify-center space-x-1";
		document.getElementById('panel-chat').classList.remove('hidden'); document.getElementById('panel-games').classList.add('hidden');
	} else {
		tg.className="flex-1 text-center py-2.5 text-xs font-bold uppercase tracking-wider text-primary border-b-2 border-primary focus:outline-none relative flex items-center justify-center space-x-1";
		tc.className="flex-1 text-center py-2.5 text-xs font-bold uppercase tracking-wider text-slate hover:text-primary focus:outline-none flex items-center justify-center space-x-1";
		document.getElementById('panel-games').classList.remove('hidden'); document.getElementById('panel-chat').classList.add('hidden');
		document.getElementById('game-dot').classList.add('hidden');
	}
};

// ==========================================
// GAMES ENGINE
// ==========================================
window.startGame = function(type) { mountGame(type, true); };
window.exitGame = function() { currentGame=null;gameActive=false; document.getElementById('game-selector').classList.remove('hidden'); document.getElementById('game-area').classList.add('hidden'); };
window.resetGame = function() { if(currentGame) mountGame(currentGame, true); };

function setStatus(s) { document.getElementById('game-status').textContent = s; }

function mountGame(type, invite=false) {
	currentGame = type; gameActive = true;
	document.getElementById('game-selector').classList.add('hidden');
	document.getElementById('game-area').classList.remove('hidden');
	const board = document.getElementById('game-board');

	if(type==='tictactoe') {
		document.getElementById('game-title').textContent = '❌ Tic-Tac-Toe';
		gameTurn = activeRole==='initiator' ? 'me' : 'them';
		tttBoard = Array(9).fill('');
		board.innerHTML = `<div class="grid grid-cols-3 gap-2 w-60 mx-auto">${Array(9).fill('').map((_,i)=>`<button class="ttt-cell bg-surface hover:bg-cream border border-hairline rounded-xl h-[76px] text-3xl font-bold transition-all" data-i="${i}"></button>`).join('')}</div>`;
		board.querySelectorAll('.ttt-cell').forEach(c => c.addEventListener('click', () => tttMove(+c.dataset.i)));
		setStatus(gameTurn==='me'?'Your turn (X)':"Stranger's turn (O)");
	} else if(type==='rps') {
		document.getElementById('game-title').textContent = '✊ Rock Paper Scissors';
		rpsRound=0; rpsScore={me:0,them:0};
		board.innerHTML = `<div class="text-center space-y-4"><p class="text-sm text-slate">Best of 3 — Pick your move:</p><div class="flex justify-center gap-3"><button class="rps-btn text-4xl p-3 bg-surface border border-hairline rounded-xl hover:bg-cream transition-all" data-m="rock">✊</button><button class="rps-btn text-4xl p-3 bg-surface border border-hairline rounded-xl hover:bg-cream transition-all" data-m="paper">✋</button><button class="rps-btn text-4xl p-3 bg-surface border border-hairline rounded-xl hover:bg-cream transition-all" data-m="scissors">✌️</button></div><p id="rps-result" class="text-sm font-bold text-ink"></p><p id="rps-scores" class="text-xs text-steel">You: 0 | Them: 0</p></div>`;
		board.querySelectorAll('.rps-btn').forEach(b => b.addEventListener('click', () => rpsMove(b.dataset.m)));
		setStatus('Pick your move!');
	} else if(type==='connect4') {
		document.getElementById('game-title').textContent = '🔴 Connect Four';
		gameTurn = activeRole==='initiator' ? 'me' : 'them';
		c4Board = Array(6).fill(null).map(()=>Array(7).fill(''));
		renderC4();
		setStatus(gameTurn==='me'?'Your turn (🔴)':"Stranger's turn (🟡)");
	} else if(type==='wordle') {
		document.getElementById('game-title').textContent = '🟩 Wordle';
		const words = ['BRAVE','CRANE','FLAME','GLOBE','HOUSE','LIGHT','MUSIC','OCEAN','PLANT','SMILE','STONE','TIGER','WORLD','CHAIR','DREAM','FRESH','GRAPE','HONEY','JUDGE','KNIFE','LEMON','MANGO','NERVE','PEACE','QUEEN','RIVER','SOLAR','THINK','URBAN','VOICE','WHEAT','YOUTH','BLAZE','CLOUD','EARTH','FROST','GRAIN','HEART','IMAGE','JOLLY','KNEEL','LUNAR','MAPLE','NIGHT','OLIVE','PIXEL','QUEST','RAPID','SPARK','TRACK'];
		wordleWord = words[Math.floor(Math.random()*words.length)];
		wordleGuesses = [];
		board.innerHTML = `<div class="space-y-4"><div id="wordle-grid" class="space-y-1.5 min-h-[180px]"></div><div class="flex justify-center gap-2"><input id="wordle-input" type="text" maxlength="5" class="w-36 bg-surface border-2 border-hairline rounded-lg px-3 h-10 text-sm uppercase font-bold text-center tracking-widest focus:ring-2 focus:ring-primary focus:border-primary focus:outline-none" placeholder="GUESS"/><button id="wordle-submit" class="bg-primary hover:bg-primary-deep text-on-primary px-5 h-10 rounded-lg font-bold text-sm transition-colors shadow-sm">→</button></div><p class="text-[10px] text-steel text-center">🟩 = correct spot | 🟨 = wrong spot | ⬜ = not in word</p></div>`;
		document.getElementById('wordle-submit').addEventListener('click', wordleGuess);
		document.getElementById('wordle-input').addEventListener('keydown', e => { if(e.key==='Enter') wordleGuess(); });
		setStatus('Guess the 5-letter word! (6 tries)');
	} else if(type==='ludo') {
		document.getElementById('game-title').textContent = '🎲 Ludo Race';
		gameTurn = activeRole==='initiator' ? 'me' : 'them';
		ludoPos = {me:0,them:0};
		board.innerHTML = `<div class="space-y-4"><div class="bg-surface rounded-xl border border-hairline p-4 space-y-3"><div class="flex justify-between text-xs font-bold"><span class="text-primary">🔴 You: <span id="ludo-me">0</span>/16</span><span class="text-blue-500">🔵 Them: <span id="ludo-them">0</span>/16</span></div><div class="h-10 bg-canvas rounded-lg border border-hairline relative"><div class="absolute right-3 top-0 bottom-0 flex items-center text-[9px] font-bold text-accent">🏁</div><div id="ludo-t-me" class="absolute w-6 h-6 bg-primary text-on-primary rounded-full flex items-center justify-center text-[10px] font-bold shadow transition-all duration-500" style="left:2%;top:15%">Y</div><div id="ludo-t-them" class="absolute w-6 h-6 bg-blue-500 text-white rounded-full flex items-center justify-center text-[10px] font-bold shadow transition-all duration-500" style="left:2%;top:45%">T</div></div></div><div class="flex justify-center gap-3"><button id="ludo-roll" class="bg-primary hover:bg-primary-deep text-on-primary font-bold text-sm px-6 py-2.5 rounded-lg shadow transition-all">🎲 Roll</button><div class="bg-surface border border-hairline px-4 py-2.5 rounded-lg"><span class="text-xs text-steel">Roll: </span><span id="ludo-dice" class="text-lg font-bold text-ink">--</span></div></div></div>`;
		document.getElementById('ludo-roll').addEventListener('click', ludoRoll);
		document.getElementById('ludo-roll').disabled = gameTurn!=='me';
		setStatus(gameTurn==='me'?'Roll the dice!':'Stranger rolling...');
	}

	if(invite && ws?.readyState===1 && matchedPeerId) {
		ws.send(JSON.stringify({type:'game_action',data:{targetPeerId:matchedPeerId,gameType:type,action:'invite',payload:{}}}));
	}
}

// --- TIC TAC TOE ---
function tttMove(i) {
	if(!gameActive||gameTurn!=='me'||tttBoard[i]) return;
	tttBoard[i] = 'X';
	renderTTT();
	sendGameAction('tictactoe','move',{i});
	const w = tttCheck();
	if(w) { gameActive=false; setStatus(w==='draw'?'Draw!':'You win! 🎉'); }
	else { gameTurn='them'; setStatus("Stranger's turn"); if(isBotCall) botGameMove(); }
}
function renderTTT() {
	document.querySelectorAll('.ttt-cell').forEach((c,idx) => {
		c.textContent = tttBoard[idx];
		c.style.color = tttBoard[idx]==='X'?'var(--color-primary)':tttBoard[idx]==='O'?'#e74c3c':'';
	});
}
function tttCheck() {
	const w=[[0,1,2],[3,4,5],[6,7,8],[0,3,6],[1,4,7],[2,5,8],[0,4,8],[2,4,6]];
	for(const[a,b,c]of w) if(tttBoard[a]&&tttBoard[a]===tttBoard[b]&&tttBoard[a]===tttBoard[c]) return tttBoard[a];
	return tttBoard.includes('')?null:'draw';
}

// --- ROCK PAPER SCISSORS ---
function rpsMove(move) {
	if(!gameActive) return;
	const botMove = ['rock','paper','scissors'][Math.floor(Math.random()*3)];
	const result = rpsResult(move, botMove);
	rpsRound++;
	if(result==='win') rpsScore.me++;
	else if(result==='lose') rpsScore.them++;
	const icons = {rock:'✊',paper:'✋',scissors:'✌️'};
	document.getElementById('rps-result').textContent = `${icons[move]} vs ${icons[botMove]} — ${result==='win'?'You win!':result==='lose'?'They win!':'Tie!'}`;
	document.getElementById('rps-scores').textContent = `You: ${rpsScore.me} | Them: ${rpsScore.them}`;
	if(rpsScore.me>=2) { gameActive=false; setStatus('You won the match! 🎉'); }
	else if(rpsScore.them>=2) { gameActive=false; setStatus('Stranger won!'); }
	else setStatus(`Round ${rpsRound+1} — Pick!`);
	sendGameAction('rps','move',{move, botMove, result});
}
function rpsResult(a,b) { if(a===b) return 'draw'; if((a==='rock'&&b==='scissors')||(a==='paper'&&b==='rock')||(a==='scissors'&&b==='paper')) return 'win'; return 'lose'; }

// --- CONNECT FOUR ---
function renderC4() {
	const board = document.getElementById('game-board');
	board.innerHTML = `<div class="flex justify-center"><div class="bg-primary/10 border border-primary/20 rounded-xl p-2 inline-block"><div class="grid grid-cols-7 gap-1" id="c4-grid">${c4Board.flat().map((_,idx)=>{const r=Math.floor(idx/7),c=idx%7;const v=c4Board[r][c];return `<div class="w-8 h-8 rounded-full border border-hairline ${v==='R'?'bg-red-500':v==='Y'?'bg-yellow-400':'bg-canvas'} cursor-pointer transition-colors" data-col="${c}"></div>`;}).join('')}</div></div></div>`;
	board.querySelectorAll('[data-col]').forEach(el => el.addEventListener('click', () => c4Drop(+el.dataset.col)));
}
function c4Drop(col) {
	if(!gameActive||gameTurn!=='me') return;
	for(let r=5;r>=0;r--) { if(!c4Board[r][col]) { c4Board[r][col]='R'; break; } else if(r===0) return; }
	renderC4();
	sendGameAction('connect4','move',{col});
	if(c4Check('R')) { gameActive=false; setStatus('You win! 🎉'); }
	else { gameTurn='them'; setStatus("Stranger's turn (🟡)"); if(isBotCall) botGameMove(); }
}
function c4Check(sym) {
	for(let r=0;r<6;r++) for(let c=0;c<7;c++) {
		if(c+3<7&&c4Board[r][c]===sym&&c4Board[r][c+1]===sym&&c4Board[r][c+2]===sym&&c4Board[r][c+3]===sym) return true;
		if(r+3<6&&c4Board[r][c]===sym&&c4Board[r+1][c]===sym&&c4Board[r+2][c]===sym&&c4Board[r+3][c]===sym) return true;
		if(r+3<6&&c+3<7&&c4Board[r][c]===sym&&c4Board[r+1][c+1]===sym&&c4Board[r+2][c+2]===sym&&c4Board[r+3][c+3]===sym) return true;
		if(r-3>=0&&c+3<7&&c4Board[r][c]===sym&&c4Board[r-1][c+1]===sym&&c4Board[r-2][c+2]===sym&&c4Board[r-3][c+3]===sym) return true;
	}
	return false;
}

// --- WORDLE ---
function wordleGuess() {
	if(!gameActive) return;
	const input = document.getElementById('wordle-input');
	if(!input) return;
	const guess = input.value.toUpperCase().trim().replace(/[^A-Z]/g,'');
	if(guess.length!==5) { setStatus('Enter exactly 5 letters!'); return; }
	input.value = '';
	wordleGuesses.push(guess);
	const grid = document.getElementById('wordle-grid');
	const row = document.createElement('div'); row.className = 'flex justify-center gap-1';
	
	// Calculate colors correctly (handle duplicate letters)
	const colors = Array(5).fill('gray');
	const wordArr = wordleWord.split('');
	const used = Array(5).fill(false);
	
	// First pass: exact matches (green)
	for(let i=0;i<5;i++) {
		if(guess[i]===wordArr[i]) { colors[i]='green'; used[i]=true; }
	}
	// Second pass: wrong position (yellow)
	for(let i=0;i<5;i++) {
		if(colors[i]==='green') continue;
		for(let j=0;j<5;j++) {
			if(!used[j]&&guess[i]===wordArr[j]) { colors[i]='yellow'; used[j]=true; break; }
		}
	}
	
	for(let i=0;i<5;i++) {
		const bg = colors[i]==='green' ? 'bg-green-500 text-white' : colors[i]==='yellow' ? 'bg-yellow-400 text-black' : 'bg-slate/30 text-ink';
		row.innerHTML += `<div class="w-10 h-10 ${bg} rounded-lg font-bold text-sm flex items-center justify-center border border-hairline shadow-sm">${guess[i]}</div>`;
	}
	grid.appendChild(row);
	if(guess===wordleWord) { gameActive=false; setStatus('🎉 Correct! Word: ' + wordleWord); }
	else if(wordleGuesses.length>=6) { gameActive=false; setStatus('❌ Game over! Word: ' + wordleWord); }
	else setStatus(`Guess ${wordleGuesses.length+1}/6 — ${6-wordleGuesses.length} left`);
	sendGameAction('wordle','guess',{guess});
}

// --- LUDO ---
function ludoRoll() {
	if(!gameActive||gameTurn!=='me') return;
	const roll = Math.floor(Math.random()*6)+1;
	document.getElementById('ludo-dice').textContent = roll;
	ludoPos.me = Math.min(16, ludoPos.me + roll);
	document.getElementById('ludo-me').textContent = ludoPos.me;
	document.getElementById('ludo-t-me').style.left = `${Math.min(88,(ludoPos.me/16)*88)}%`;
	sendGameAction('ludo','roll',{roll,pos:ludoPos.me});
	if(ludoPos.me>=16) { gameActive=false; setStatus('You won! 🏆'); document.getElementById('ludo-roll').disabled=true; }
	else { gameTurn='them'; setStatus('Stranger rolling...'); document.getElementById('ludo-roll').disabled=true; if(isBotCall) botGameMove(); }
}

// --- GAME COMMS ---
function sendGameAction(type, action, payload) {
	if(ws?.readyState===1&&matchedPeerId) ws.send(JSON.stringify({type:'game_action',data:{targetPeerId:matchedPeerId,gameType:type,action,payload}}));
}

function onGameAction(data) {
	const {gameType, action, payload} = data;
	if(document.getElementById('panel-games').classList.contains('hidden')) { document.getElementById('game-dot').classList.remove('hidden'); addSystemMsg('🎮 Stranger started a game!'); }
	if(currentGame!==gameType) mountGame(gameType, false);

	if(gameType==='tictactoe'&&action==='move') {
		tttBoard[payload.i]='O'; renderTTT();
		const w=tttCheck(); if(w){gameActive=false;setStatus(w==='draw'?'Draw!':'Stranger wins!');} else{gameTurn='me';setStatus('Your turn');}
	} else if(gameType==='connect4'&&action==='move') {
		for(let r=5;r>=0;r--) { if(!c4Board[r][payload.col]){c4Board[r][payload.col]='Y';break;} }
		renderC4(); if(c4Check('Y')){gameActive=false;setStatus('Stranger wins!');} else{gameTurn='me';setStatus('Your turn (🔴)');}
	} else if(gameType==='ludo'&&action==='roll') {
		ludoPos.them=payload.pos; document.getElementById('ludo-them').textContent=ludoPos.them;
		document.getElementById('ludo-t-them').style.left=`${Math.min(88,(ludoPos.them/16)*88)}%`;
		document.getElementById('ludo-dice').textContent=payload.roll;
		if(ludoPos.them>=16){gameActive=false;setStatus('Stranger won!');} else{gameTurn='me';setStatus('Roll the dice!');document.getElementById('ludo-roll').disabled=false;}
	}
}

// Bot game moves
function botGameMove() {
	if(!isBotCall||!gameActive||gameTurn!=='them') return;
	setStatus('Stranger thinking...');
	setTimeout(()=>{
		if(!gameActive||gameTurn!=='them') return;
		if(currentGame==='tictactoe') {
			const avail=tttBoard.map((v,i)=>v===''?i:-1).filter(i=>i!==-1);
			if(avail.length) { const i=avail[Math.floor(Math.random()*avail.length)]; tttBoard[i]='O'; renderTTT(); const w=tttCheck(); if(w){gameActive=false;setStatus(w==='draw'?'Draw!':'Stranger wins!');}else{gameTurn='me';setStatus('Your turn');} }
		} else if(currentGame==='connect4') {
			const cols=[];for(let c=0;c<7;c++){if(!c4Board[0][c])cols.push(c);}
			if(cols.length){const col=cols[Math.floor(Math.random()*cols.length)];for(let r=5;r>=0;r--){if(!c4Board[r][col]){c4Board[r][col]='Y';break;}}renderC4();if(c4Check('Y')){gameActive=false;setStatus('Stranger wins!');}else{gameTurn='me';setStatus('Your turn (🔴)');}}
		} else if(currentGame==='ludo') {
			const roll=Math.floor(Math.random()*6)+1;ludoPos.them=Math.min(16,ludoPos.them+roll);
			document.getElementById('ludo-them').textContent=ludoPos.them;document.getElementById('ludo-t-them').style.left=`${Math.min(88,(ludoPos.them/16)*88)}%`;document.getElementById('ludo-dice').textContent=roll;
			if(ludoPos.them>=16){gameActive=false;setStatus('Stranger won!');}else{gameTurn='me';setStatus('Roll the dice!');document.getElementById('ludo-roll').disabled=false;}
		}
	}, 1000+Math.random()*800);
}

