---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Airwalk Chat | Talk to Strangers — Free Voice & Text Chat" description="Start chatting with random strangers instantly. Voice or text, your choice. Free gender & country filters, games, friends system.">
	<!-- Header -->
	<header class="bg-canvas/80 backdrop-blur-xl border-b border-hairline h-14 flex items-center justify-between px-4 md:px-6 sticky top-0 z-40">
		<a href="/" class="flex items-center space-x-2 text-ink">
			<svg class="w-7 h-7 text-primary" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2z"/></svg>
			<span class="font-sans font-extrabold text-lg tracking-tight uppercase">Airwalk</span>
		</a>
		<div class="flex items-center space-x-3">
			<button id="friends-toggle" class="relative w-9 h-9 flex items-center justify-center rounded-full bg-surface border border-hairline hover:bg-cream transition-colors" title="Friends">
				👥
				<span id="friend-badge" class="hidden absolute -top-0.5 -right-0.5 w-4 h-4 bg-primary text-on-primary text-[9px] font-bold rounded-full flex items-center justify-center">0</span>
			</button>
			<button id="history-toggle" class="w-9 h-9 flex items-center justify-center rounded-full bg-surface border border-hairline hover:bg-cream transition-colors" title="Call History">📋</button>
			<button id="theme-toggle" class="w-9 h-9 flex items-center justify-center rounded-full bg-surface border border-hairline hover:bg-cream transition-colors" aria-label="Toggle theme">
				<svg class="w-4 h-4 text-yellow-saturated hidden dark-icon" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l.707.707a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 1.414zm2.12-10.607a1 1 0 010 1.414l-.706.707a1 1 0 11-1.414-1.414l.707-.707a1 1 0 011.414 0zM17 11a1 1 0 100-2h-1a1 1 0 100 2h1zm-7 4a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM5.05 6.464A1 1 0 106.465 5.05l-.708-.707a1 1 0 00-1.414 1.414l.707.707zm1.414 8.486l-.707.707a1 1 0 01-1.414-1.414l.707-.707a1 1 0 011.414 1.414zM4 11a1 1 0 100-2H3a1 1 0 000 2h1z" clip-rule="evenodd"/></svg>
				<svg class="w-4 h-4 text-slate light-icon" fill="currentColor" viewBox="0 0 20 20"><path d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z"/></svg>
			</button>
			<span class="text-xs font-mono text-slate bg-surface px-2 py-1 rounded-md hidden sm:block" id="online-indicator">🟢 Online</span>
		</div>
	</header>

	<main class="flex-grow flex flex-col bg-gradient-to-br from-surface via-canvas to-surface relative">
		<!-- Alert Banner -->
		<div id="alert-banner" class="hidden bg-primary-deep text-on-primary py-2 px-6 text-center text-sm font-semibold flex items-center justify-center space-x-2 z-50">
			<span id="alert-message"></span>
			<button class="bg-black/20 hover:bg-black/35 px-2 py-0.5 rounded text-xs" onclick="document.getElementById('alert-banner').classList.add('hidden')">✕</button>
		</div>

		<!-- Friends Panel (Side Drawer) -->
		<div id="friends-panel" class="hidden fixed inset-y-0 right-0 w-full sm:w-80 bg-canvas border-l border-hairline shadow-2xl z-50 flex flex-col">
			<div class="p-4 border-b border-hairline flex items-center justify-between">
				<h3 class="font-bold text-ink">Friends</h3>
				<button onclick="document.getElementById('friends-panel').classList.add('hidden')" class="text-slate hover:text-ink text-xl">✕</button>
			</div>
			<div id="friends-list" class="flex-grow overflow-y-auto p-4 space-y-2">
				<p class="text-sm text-steel text-center py-8">No friends yet. Add people you connect with!</p>
			</div>
		</div>

		<!-- History Panel (Side Drawer) -->
		<div id="history-panel" class="hidden fixed inset-y-0 right-0 w-full sm:w-80 bg-canvas border-l border-hairline shadow-2xl z-50 flex flex-col">
			<div class="p-4 border-b border-hairline flex items-center justify-between">
				<h3 class="font-bold text-ink">Call History</h3>
				<button onclick="document.getElementById('history-panel').classList.add('hidden')" class="text-slate hover:text-ink text-xl">✕</button>
			</div>
			<div id="history-list" class="flex-grow overflow-y-auto p-4 space-y-2">
				<p class="text-sm text-steel text-center py-8">No call history yet.</p>
			</div>
		</div>

		<!-- SCREENS CONTAINER -->
		<div class="flex-grow flex items-center justify-center p-3 md:p-8">

			<!-- SCREEN 1: SETUP -->
			<div id="setup-screen" class="w-full max-w-[520px] bg-canvas border border-hairline rounded-2xl p-6 md:p-8 shadow-2xl space-y-5 relative overflow-hidden">
				<!-- Decorative gradient blob -->
				<div class="absolute -top-20 -right-20 w-48 h-48 bg-primary/10 rounded-full blur-3xl pointer-events-none"></div>
				<div class="absolute -bottom-16 -left-16 w-40 h-40 bg-accent/10 rounded-full blur-3xl pointer-events-none"></div>

				<!-- Your anonymous identity -->
				<div class="relative flex items-center space-x-3 bg-gradient-to-r from-primary/5 to-accent/5 border border-primary/10 rounded-xl p-3">
					<div id="my-avatar" class="w-11 h-11 bg-primary/15 text-primary flex items-center justify-center rounded-full text-xl shadow-sm">🦊</div>
					<div>
						<p class="font-bold text-sm text-ink" id="my-handle">CoolFox429</p>
						<p class="text-[10px] text-steel">Your anonymous identity</p>
					</div>
					<button onclick="generateHandle()" class="ml-auto text-xs text-primary font-semibold hover:underline bg-primary/10 px-2.5 py-1 rounded-full">↻ New</button>
				</div>

				<div class="text-center space-y-1 relative">
					<h1 class="text-2xl md:text-3xl font-extrabold text-ink">Start a Conversation</h1>
					<p class="text-sm text-slate">Voice or text. All filters free. No signup needed.</p>
				</div>

				<!-- Profile Info (Optional) -->
				<div class="space-y-2 relative">
					<p class="text-[11px] text-steel font-medium uppercase tracking-wider">Optional — helps match you better</p>
					<div class="grid grid-cols-3 gap-2">
						<div>
							<input type="text" id="user-name" placeholder="Name" maxlength="20" class="w-full bg-surface text-ink text-sm rounded-lg border border-hairline px-3 h-10 focus:ring-2 focus:ring-primary focus:outline-none placeholder:text-stone" />
						</div>
						<div>
							<input type="number" id="user-age" placeholder="Age" min="13" max="99" class="w-full bg-surface text-ink text-sm rounded-lg border border-hairline px-3 h-10 focus:ring-2 focus:ring-primary focus:outline-none placeholder:text-stone" />
						</div>
						<div>
							<select id="user-gender" class="w-full bg-surface text-ink text-sm rounded-lg border border-hairline p-2 h-10 focus:ring-2 focus:ring-primary focus:outline-none">
								<option value="Male">♂ Male</option>
								<option value="Female">♀ Female</option>
								<option value="Other">⚧ Other</option>
							</select>
						</div>
					</div>
				</div>

				<!-- Chat Mode Selection -->
				<div class="grid grid-cols-2 gap-3 relative">
					<button id="mode-voice" class="bg-primary text-on-primary border-2 border-primary rounded-xl p-3.5 text-center font-bold text-sm transition-all shadow-md hover:shadow-lg" onclick="setChatMode('voice')">
						🎙️ Voice Chat
					</button>
					<button id="mode-text" class="bg-surface text-ink border-2 border-hairline rounded-xl p-3.5 text-center font-bold text-sm transition-all hover:border-primary hover:shadow-md" onclick="setChatMode('text')">
						💬 Text Only
					</button>
				</div>

				<!-- Filters -->
				<div class="space-y-3">
					<div class="grid grid-cols-2 gap-3">
						<div class="space-y-1">
							<label class="block text-xs font-semibold text-slate uppercase tracking-wider">Language</label>
							<div class="relative">
								<input type="text" id="language-search" placeholder="Search language..." class="w-full bg-surface text-ink text-sm rounded-lg border border-hairline px-3 h-10 focus:ring-2 focus:ring-primary focus:outline-none" autocomplete="off" />
								<input type="hidden" id="language-filter" value="English" />
								<div id="language-dropdown" class="hidden absolute z-20 w-full mt-1 bg-canvas border border-hairline rounded-lg shadow-lg max-h-48 overflow-y-auto"></div>
							</div>
						</div>
						<div class="space-y-1">
							<label class="block text-xs font-semibold text-slate uppercase tracking-wider">Country</label>
							<div class="relative">
								<input type="text" id="country-search" placeholder="Search country..." class="w-full bg-surface text-ink text-sm rounded-lg border border-hairline px-3 h-10 focus:ring-2 focus:ring-primary focus:outline-none" autocomplete="off" />
								<input type="hidden" id="country-filter" value="Worldwide" />
								<div id="country-dropdown" class="hidden absolute z-20 w-full mt-1 bg-canvas border border-hairline rounded-lg shadow-lg max-h-48 overflow-y-auto"></div>
							</div>
						</div>
					</div>

					<!-- Interests -->
					<div class="space-y-1">
						<label class="block text-xs font-semibold text-slate uppercase tracking-wider">Interests</label>
						<input type="text" id="interest-input" placeholder="gaming, music, coding..." class="w-full bg-surface text-ink text-sm rounded-lg border border-hairline px-3 h-10 focus:ring-2 focus:ring-primary focus:outline-none" />
						<div class="flex flex-wrap gap-1.5 pt-1">
							<button class="bg-primary-light text-primary text-[11px] font-medium px-2 py-0.5 rounded-full hover:bg-primary hover:text-on-primary transition-colors" onclick="addTag('Gaming')">+ Gaming</button>
							<button class="bg-primary-light text-primary text-[11px] font-medium px-2 py-0.5 rounded-full hover:bg-primary hover:text-on-primary transition-colors" onclick="addTag('Music')">+ Music</button>
							<button class="bg-primary-light text-primary text-[11px] font-medium px-2 py-0.5 rounded-full hover:bg-primary hover:text-on-primary transition-colors" onclick="addTag('Anime')">+ Anime</button>
							<button class="bg-primary-light text-primary text-[11px] font-medium px-2 py-0.5 rounded-full hover:bg-primary hover:text-on-primary transition-colors" onclick="addTag('Movies')">+ Movies</button>
							<button class="bg-primary-light text-primary text-[11px] font-medium px-2 py-0.5 rounded-full hover:bg-primary hover:text-on-primary transition-colors" onclick="addTag('Tech')">+ Tech</button>
							<button class="bg-primary-light text-primary text-[11px] font-medium px-2 py-0.5 rounded-full hover:bg-primary hover:text-on-primary transition-colors" onclick="addTag('Sports')">+ Sports</button>
						</div>
					</div>
				</div>

				<button id="start-match-btn" class="w-full bg-gradient-to-r from-primary to-primary-deep hover:from-primary-deep hover:to-primary text-on-primary font-bold text-base py-4 rounded-xl transition-all shadow-lg hover:shadow-xl relative overflow-hidden group">
					<span class="relative z-10">🚀 Start Matching</span>
					<div class="absolute inset-0 bg-white/10 translate-x-[-100%] group-hover:translate-x-[100%] transition-transform duration-700 skew-x-12"></div>
				</button>
				<p class="text-center text-[11px] text-steel">🔒 Anonymous • No signup • Free forever</p>
			</div>

			<!-- SCREEN 2: SEARCHING -->
			<div id="matching-screen" class="hidden w-full max-w-[460px] bg-canvas border border-hairline rounded-xl p-8 shadow-lg flex flex-col items-center text-center space-y-8 min-h-[380px]">
				<div class="space-y-2">
					<h2 class="text-2xl font-bold text-ink">Finding someone...</h2>
					<p class="text-sm text-slate" id="search-mode-label">Voice Chat</p>
				</div>
				<div class="relative w-32 h-32 flex items-center justify-center">
					<div class="absolute inset-0 bg-primary/10 rounded-full animate-radar"></div>
					<div class="absolute inset-4 bg-primary/20 rounded-full animate-radar" style="animation-delay:0.6s"></div>
					<div class="relative w-14 h-14 bg-primary rounded-full flex items-center justify-center text-on-primary text-xl shadow-lg animate-pulse" id="search-icon">🎙️</div>
				</div>
				<div id="search-details" class="bg-surface rounded-lg border border-hairline p-3 w-full text-xs text-slate text-left"></div>
				<button id="cancel-match-btn" class="bg-surface border border-hairline hover:bg-cream text-ink text-sm font-semibold py-2.5 px-6 rounded-lg transition-colors">Cancel</button>
			</div>

			<!-- SCREEN 3: ACTIVE CALL/CHAT -->
			<div id="call-screen" class="hidden w-full max-w-[1000px] bg-canvas border border-hairline rounded-2xl shadow-2xl overflow-hidden grid grid-cols-1 md:grid-cols-12 max-h-[90vh] md:max-h-none md:min-h-[540px]">

				<!-- Left Panel: Voice/Info -->
				<div class="md:col-span-7 p-4 md:p-5 flex flex-col justify-between md:border-r border-hairline bg-gradient-to-b from-surface/80 to-canvas overflow-y-auto">
					<div class="space-y-4">
						<!-- Status Bar -->
						<div class="flex items-center justify-between">
							<span class="inline-flex items-center space-x-1.5 bg-accent/10 border border-accent/20 text-accent px-3 py-1 rounded-full text-xs font-semibold">
								<span class="w-2 h-2 bg-accent rounded-full animate-ping"></span>
								<span id="call-status-label">Live Call</span>
							</span>
							<span id="call-timer" class="text-sm font-mono text-slate font-semibold">00:00</span>
						</div>

						<!-- Partner Info Card -->
						<div class="bg-canvas border border-hairline rounded-xl p-4 flex items-center space-x-4 shadow-sm hover:shadow-md transition-shadow">
							<div id="partner-avatar" class="w-11 h-11 bg-primary/10 text-primary flex items-center justify-center rounded-full text-lg font-bold">🐻</div>
							<div class="space-y-1 flex-grow">
								<div class="flex items-center justify-between">
									<h4 id="partner-handle" class="font-bold text-base text-ink">Stranger</h4>
									<span id="partner-country" class="text-xs bg-surface text-slate px-2 py-0.5 rounded-full">🌍 --</span>
								</div>
								<div class="flex items-center space-x-2 text-xs text-steel">
									<span id="partner-lang">--</span>
								</div>
								<div id="partner-tags" class="flex flex-wrap gap-1 pt-1"></div>
							</div>
						</div>
					</div>

					<!-- Equalizer (Voice mode only) -->
					<div id="eq-section" class="my-6 flex items-center justify-center h-24 space-x-1">
						<div class="w-1.5 h-12 bg-primary rounded-full animate-pulse eq-bar"></div>
						<div class="w-1.5 h-18 bg-primary/70 rounded-full animate-pulse-slow eq-bar"></div>
						<div class="w-1.5 h-22 bg-primary rounded-full animate-pulse eq-bar"></div>
						<div class="w-1.5 h-14 bg-primary/50 rounded-full animate-pulse-slow eq-bar"></div>
						<div class="w-1.5 h-8 bg-primary rounded-full animate-pulse eq-bar"></div>
						<div class="w-1.5 h-16 bg-primary/70 rounded-full animate-pulse-slow eq-bar"></div>
						<div class="w-1.5 h-20 bg-primary rounded-full animate-pulse eq-bar"></div>
						<div class="w-1.5 h-10 bg-primary/50 rounded-full animate-pulse eq-bar"></div>
					</div>

					<!-- Text-only mode message -->
					<div id="text-mode-info" class="hidden my-6 text-center text-sm text-slate py-8">
						<p class="text-3xl mb-2">💬</p>
						<p>Text-only mode — use the chat panel →</p>
					</div>

					<!-- Controls -->
					<div class="flex flex-wrap items-center justify-center md:justify-between gap-2 pt-4 border-t border-hairline">
						<div class="flex items-center space-x-2">
							<button id="mute-btn" class="bg-canvas border border-hairline hover:bg-cream text-ink px-3 py-2 rounded-lg text-sm font-medium transition-colors">🎙️ Mute</button>
							<input type="range" id="volume-slider" min="0" max="1" step="0.1" value="0.8" class="w-16 accent-primary hidden sm:block" />
						</div>
						<div class="flex items-center flex-wrap justify-center gap-2">
							<button id="add-friend-btn" class="text-xs bg-accent/10 hover:bg-accent hover:text-on-primary text-accent border border-accent/20 px-2.5 py-2 rounded-lg font-medium transition-colors">➕ Friend</button>
							<button id="block-btn" class="text-xs hover:bg-red-50 text-red-500 border border-red-200 px-2.5 py-2 rounded-lg font-medium transition-colors">🚫</button>
							<button id="report-btn" class="text-xs hover:bg-red-50 text-red-500 border border-red-200 px-2.5 py-2 rounded-lg font-medium transition-colors">⚠️</button>
							<button id="skip-btn" class="bg-primary hover:bg-primary-deep text-on-primary px-5 py-2 rounded-lg font-bold transition-all shadow-sm disabled:bg-muted disabled:text-steel disabled:cursor-not-allowed">
								<span id="skip-btn-label">Skip (5s)</span>
							</button>
						</div>
					</div>
				</div>

				<!-- Right Panel: Chat + Games -->
				<div class="md:col-span-5 flex flex-col h-[400px] md:h-auto border-t md:border-t-0 border-hairline">
					<!-- Tabs -->
					<div class="bg-canvas border-b border-hairline flex">
						<button id="tab-chat-btn" class="flex-1 text-center py-3 text-xs font-bold uppercase tracking-wider text-primary border-b-2 border-primary focus:outline-none" onclick="switchTab('chat')">💬 Chat</button>
						<button id="tab-games-btn" class="flex-1 text-center py-3 text-xs font-bold uppercase tracking-wider text-slate hover:text-primary focus:outline-none relative" onclick="switchTab('games')">
							🎮 Games
							<span id="game-dot" class="hidden absolute top-2 right-[28%] w-2 h-2 bg-accent rounded-full animate-ping"></span>
						</button>
					</div>

					<!-- Chat Panel -->
					<div id="panel-chat" class="flex-grow flex flex-col overflow-hidden">
						<div id="chat-messages" class="flex-grow p-4 space-y-3 overflow-y-auto text-sm min-h-[280px]">
							<div class="text-center text-xs text-slate italic bg-surface py-1.5 px-3 rounded-lg">Connected! Say hello 👋</div>
						</div>
						<div id="typing-indicator" class="hidden px-4 py-1 text-xs text-steel italic">Stranger is typing...</div>
						<div class="p-3 bg-surface border-t border-hairline flex items-center space-x-2">
							<button id="image-btn" class="w-9 h-9 flex items-center justify-center rounded-lg bg-canvas border border-hairline hover:bg-cream text-sm transition-colors" title="Send Image">📷</button>
							<input type="text" id="chat-input" placeholder="Type a message..." class="flex-grow bg-canvas text-ink text-sm rounded-lg border border-hairline px-3 h-10 focus:ring-2 focus:ring-primary focus:outline-none" />
							<button id="send-btn" class="bg-primary hover:bg-primary-deep text-on-primary px-4 h-10 rounded-lg font-semibold text-sm transition-colors">Send</button>
						</div>
						<input type="file" id="image-input" accept="image/*" class="hidden" />
					</div>

					<!-- Games Panel -->
					<div id="panel-games" class="hidden flex-grow flex flex-col overflow-y-auto p-4 space-y-3">
						<div id="game-selector" class="space-y-2">
							<h3 class="text-sm font-bold text-ink">Choose a Game</h3>
							<div class="grid grid-cols-1 gap-2">
								<button class="group bg-surface hover:bg-primary-light border border-hairline hover:border-primary/30 p-3 rounded-xl flex items-center space-x-3 transition-all" onclick="startGame('tictactoe')">
									<span class="text-xl">❌</span>
									<div class="flex-grow text-left"><p class="font-bold text-sm text-ink">Tic-Tac-Toe</p><p class="text-[10px] text-steel">Classic 3×3 grid</p></div>
								</button>
								<button class="group bg-surface hover:bg-primary-light border border-hairline hover:border-primary/30 p-3 rounded-xl flex items-center space-x-3 transition-all" onclick="startGame('rps')">
									<span class="text-xl">✊</span>
									<div class="flex-grow text-left"><p class="font-bold text-sm text-ink">Rock Paper Scissors</p><p class="text-[10px] text-steel">Best of 3 rounds</p></div>
								</button>
								<button class="group bg-surface hover:bg-primary-light border border-hairline hover:border-primary/30 p-3 rounded-xl flex items-center space-x-3 transition-all" onclick="startGame('connect4')">
									<span class="text-xl">🔴</span>
									<div class="flex-grow text-left"><p class="font-bold text-sm text-ink">Connect Four</p><p class="text-[10px] text-steel">Drop 4 in a row</p></div>
								</button>
								<button class="group bg-surface hover:bg-primary-light border border-hairline hover:border-primary/30 p-3 rounded-xl flex items-center space-x-3 transition-all" onclick="startGame('wordle')">
									<span class="text-xl">🟩</span>
									<div class="flex-grow text-left"><p class="font-bold text-sm text-ink">Wordle</p><p class="text-[10px] text-steel">Guess the 5-letter word</p></div>
								</button>
								<button class="group bg-surface hover:bg-primary-light border border-hairline hover:border-primary/30 p-3 rounded-xl flex items-center space-x-3 transition-all" onclick="startGame('ludo')">
									<span class="text-xl">🎲</span>
									<div class="flex-grow text-left"><p class="font-bold text-sm text-ink">Ludo Race</p><p class="text-[10px] text-steel">Race to the finish</p></div>
								</button>
							</div>
						</div>

						<!-- Active Game Area -->
						<div id="game-area" class="hidden space-y-3">
							<div class="flex items-center justify-between">
								<button class="text-xs text-primary font-medium" onclick="exitGame()">← Back</button>
								<span id="game-title" class="font-bold text-sm text-ink"></span>
								<button class="text-xs text-primary font-medium" onclick="resetGame()">Reset</button>
							</div>
							<div id="game-status" class="bg-primary-light text-primary text-center text-xs font-semibold py-2 rounded-lg border border-primary/20">Loading...</div>
							<div id="game-board"></div>
						</div>
					</div>
				</div>
			</div>
		</div>

		<audio id="remote-audio" autoplay class="hidden"></audio>
	</main>
	<div class="h-1.5 w-full sunset-stripe"></div>
</Layout>

<script is:inline>
// ==========================================
// THEME TOGGLE
// ==========================================
const themeToggle = document.getElementById('theme-toggle');
function updateThemeIcons() {
	const d = document.documentElement.classList.contains('dark');
	document.querySelectorAll('.dark-icon').forEach(el => el.style.display = d ? 'block' : 'none');
	document.querySelectorAll('.light-icon').forEach(el => el.style.display = d ? 'none' : 'block');
}
updateThemeIcons();
themeToggle.addEventListener('click', () => {
	document.documentElement.classList.toggle('dark');
	localStorage.setItem('theme', document.documentElement.classList.contains('dark') ? 'dark' : 'light');
