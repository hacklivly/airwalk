---
export const prerender = false;
import Layout from '../../layouts/Layout.astro';

const ADMIN_USER = import.meta.env.ADMIN_USERNAME || 'harsh';
const ADMIN_PASS = import.meta.env.ADMIN_PASSWORD || 'harshverma@09';

let error = '';

if (Astro.request.method === 'POST') {
  const data = await Astro.request.formData();
  const username = data.get('username');
  const password = data.get('password');

  if (username === ADMIN_USER && password === ADMIN_PASS) {
    Astro.cookies.set('admin_session', 'authenticated', {
      path: '/',
      httpOnly: true,
      secure: true,
      maxAge: 60 * 60 * 24,
    });
    return Astro.redirect('/admin/dashboard');
  } else {
    error = 'Invalid username or password.';
  }
}
---

<Layout title="Admin Login | Airwalk" noindex={true}>
  <div class="min-h-screen flex items-center justify-center p-4">
    <div class="w-full max-w-sm bg-surface border border-hairline rounded-2xl p-8 shadow-xl space-y-6">
      <div class="text-center">
        <h1 class="text-2xl font-extrabold text-ink">Admin Login</h1>
        <p class="text-sm text-slate mt-1">Airwalk Blog Manager</p>
      </div>

      {error && <p class="text-sm text-red-500 bg-red-50 border border-red-200 rounded-lg px-4 py-2">{error}</p>}

      <form method="POST" class="space-y-4">
        <div>
          <label class="text-sm font-semibold text-ink block mb-1">Username</label>
          <input type="text" name="username" required class="w-full bg-canvas border border-hairline rounded-lg px-4 h-11 text-ink focus:ring-2 focus:ring-primary focus:outline-none" />
        </div>
        <div>
          <label class="text-sm font-semibold text-ink block mb-1">Password</label>
          <input type="password" name="password" required class="w-full bg-canvas border border-hairline rounded-lg px-4 h-11 text-ink focus:ring-2 focus:ring-primary focus:outline-none" />
        </div>
        <button type="submit" class="w-full bg-primary hover:bg-primary-deep text-on-primary font-bold py-3 rounded-lg transition-colors">Login</button>
      </form>

      <p class="text-center text-xs text-steel"><a href="/" class="text-primary hover:underline">← Back to Airwalk</a></p>
    </div>
  </div>
</Layout>
