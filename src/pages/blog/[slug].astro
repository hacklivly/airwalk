---
export const prerender = false;
import Layout from '../../layouts/Layout.astro';

const { slug } = Astro.params;
const runtime = Astro.locals.runtime;
const db = runtime.env.DB;

const result = await db.prepare('SELECT * FROM blogs WHERE slug = ?').bind(slug).first();

if (!result) {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}

const post = result as any;
const schemaData = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: post.title,
  datePublished: post.created_at,
  author: { "@type": "Person", name: "Airwalk" },
  description: post.description || `Read about ${post.title} on Airwalk.`,
};
---

<Layout
  title={`${post.title} | Airwalk Blog`}
  description={post.description || `Read about ${post.title} on Airwalk.`}
  canonicalURL={`https://airwalk.pages.dev/blog/${slug}`}
  ogImage={post.featured_image || '/og-image.png'}
>
  <Fragment slot="head">
    {post.featured_image && <link rel="preload" as="image" href={post.featured_image} />}
    <script type="application/ld+json" set:html={JSON.stringify(schemaData)} />
  </Fragment>

  <header class="bg-canvas/80 backdrop-blur-xl border-b border-hairline h-14 flex items-center px-4 md:px-8 sticky top-0 z-40">
    <a href="/" class="flex items-center space-x-2 text-ink">
      <svg class="w-7 h-7 text-primary" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2z"/></svg>
      <span class="font-extrabold text-lg uppercase">Airwalk</span>
    </a>
  </header>

  <main class="max-w-[680px] mx-auto px-4 py-10 space-y-6">
    <nav class="text-sm text-slate">
      <a href="/" class="text-primary hover:underline">Home</a> <span class="mx-1">›</span>
      <a href="/blog" class="text-primary hover:underline">Blog</a> <span class="mx-1">›</span>
      <span class="text-ink">{post.title}</span>
    </nav>

    <header class="space-y-3">
      <h1 class="text-3xl md:text-4xl font-extrabold text-ink leading-tight">{post.title}</h1>
      <p class="text-sm text-slate">Published {new Date(post.created_at).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</p>
    </header>

    {post.featured_image && (
      <img src={post.featured_image} alt={post.title} width="680" height="380" class="w-full rounded-xl border border-hairline object-cover" loading="eager" />
    )}

    <article class="prose prose-lg text-ink leading-relaxed space-y-4 [&_h2]:text-2xl [&_h2]:font-bold [&_h2]:mt-8 [&_h2]:mb-3 [&_p]:text-base [&_p]:leading-relaxed [&_ul]:list-disc [&_ul]:pl-6 [&_ol]:list-decimal [&_ol]:pl-6 [&_a]:text-primary [&_a]:underline [&_img]:rounded-xl [&_img]:max-w-full [&_img]:h-auto" set:html={post.content} />

    <div class="border-t border-hairline pt-8 mt-12 text-center">
      <a href="/chat" class="inline-block bg-primary hover:bg-primary-deep text-on-primary font-bold py-3 px-8 rounded-lg transition-colors">Start Chatting — Free</a>
    </div>
  </main>

  <footer class="border-t border-hairline py-8 px-4 text-center text-xs text-steel">
    <p>© 2025 Airwalk. <a href="/" class="text-primary hover:underline">Home</a> · <a href="/blog" class="text-primary hover:underline">Blog</a> · <a href="/privacy" class="text-primary hover:underline">Privacy</a></p>
  </footer>
</Layout>
